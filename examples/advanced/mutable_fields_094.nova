extern fn puts(text: str) -> i32;

#[derive(Serialize)]
struct User { id: u64, name: str, active: bool }

impl User {
    // A mutable pointer updates the caller's original User.
    fn set(self: *mut User, data: u64) -> () {
        unsafe { self.id = data; }
        return;
    }
}

fn main() -> i32 {
    let mut user: User = new User {
        id: 42,
        name: "Nova \"Language\"",
        active: true
    };
    user.id = 100;
    user.id += 2;
    unsafe {
        let pointer: *mut User = &mut user;
        pointer.set(200);
    }
    if user.id != 200 as u64 { return 1; }
    User_write_json(user);
    puts("");
    return 0;
}
