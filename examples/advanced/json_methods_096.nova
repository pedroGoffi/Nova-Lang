// Nova 0.9.6: static + instance JSON helpers on any derive-enabled type.
extern fn puts(text: str) -> i32;
extern fn strcmp(a: str, b: str) -> i32;

#[derive(Serialize, Deserialize)]
struct Address { zip: i32, active: bool }

#[derive(Serialize, Deserialize)]
struct User { id: u64, name: str, address: Address }

fn main() -> i32 {
    let json: str = "{\"id\":200,\"name\":\"Nova \\\"Language\\\"\",\"address\":{\"zip\":99000,\"active\":true}}";
    let user = User::fromJson(json);
    if user.id != 200 as u64 { return 1; }
    if user.address.zip != 99000 { return 2; }

    let encoded: str = user.toJson();
    puts(encoded);
    let second = User::fromJson(encoded);
    if second.id != user.id { return 3; }
    if strcmp(second.name, user.name) != 0 { return 4; }
    if !second.address.active { return 5; }
    // Static form is also accepted.
    let static_json: str = User::toJson(second);
    if strcmp(static_json,encoded) != 0 { return 6; }
    return 0;
}
