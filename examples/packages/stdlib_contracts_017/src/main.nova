// Runtime regression: owned strings retain their ownership after borrowed use.
fn main() -> i32 {
    let original: std::string::String = std::string::from_text("Nova");
    let duplicate: std::string::String = std::string::copy_of(&original);
    let fragment: std::string::String = std::string::slice(&original, 0, 2);
    if duplicate.len() != 4 { return 1; }
    if !fragment.equals("No") { return 2; }
    if original.len() != 4 { return 3; }

    let writer: std::builder::StringBuilder = std::builder::make();
    writer.append_string(&original);
    writer.append("!");
    let built: std::string::String = writer.to_string();
    if !built.equals("Nova!") { return 4; }
    if !original.equals("Nova") { return 5; }

    let escaped: std::string::String = std::json::quoted_string(&original);
    if !escaped.equals("\"Nova\"") { return 6; }
    if !original.equals("Nova") { return 7; }

    let symbols: std::symbol::SymbolTable = std::symbol::new_table();
    symbols.define("answer", 42);
    if symbols.resolve_or("answer", 0) != 42 { return 8; }

    let source: std::memory::ByteBuffer = std::memory::new_buffer(2);
    let destination: std::memory::ByteBuffer = std::memory::new_buffer(2);
    source.write(0, 65);
    destination.copy_from(0, &source, 0, 1);
    if destination.read(0) != 65 || source.read(0) != 65 { return 9; }

    let error: std::error::OwnedError = std::error::owned(12,"problem");
    if error.code() != 12 { return 10; }
    return 0;
}
