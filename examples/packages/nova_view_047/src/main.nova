import std;
import nova_view;

fn main() -> i32 {
    let view = nova_view::create();
    view.open("main");
    view.attr("class","nv-main");
    if !view.element("h1","Vendas <Novas>") { return 1; }
    view.text_i64(1234);
    view.end();
    let result = view.render();
    if !result.contains("Vendas &lt;Novas&gt;") { return 2; }
    if !result.contains("1234") { return 3; }

    let details = nova_view::components::metric("Faturamento","R$ 50.000","+12% no período",true);
    if !details.contains("nv-metric-value") { return 4; }
    let alert = nova_view::components::notice("Atenção","Prazo < 3 dias","warning");
    if !alert.contains("Prazo &lt; 3 dias") { return 5; }
    let link = nova_view::components::nav_link("Abrir","javascript:alert(1)",true);
    if !link.contains("href=\"#\"") { return 6; }
    let progress = nova_view::components::progress("Concluído",120);
    if !progress.contains("value=\"100\"") { return 7; }

    let f = nova_view::forms::field("email","E-mail","a\"b","email",true);
    if !f.contains("a&quot;b") || !f.contains("required") { return 8; }
    let area = nova_view::forms::textarea("note","Nota","<script>",4);
    if !area.contains("&lt;script&gt;") { return 9; }
    let choice = nova_view::forms::option("x\"y","Item <1>",true);
    if !choice.contains("x&quot;y") || !choice.contains("Item &lt;1&gt;") { return 10; }

    let table = nova_view::create();
    nova_view::table::open(&table,"Pedidos recentes");
    nova_view::table::header_start(&table);
    nova_view::table::heading(&table,"Cliente");
    nova_view::table::header_end(&table);
    nova_view::table::row_start(&table);
    nova_view::table::cell(&table,"<Ana>");
    nova_view::table::row_end(&table);
    nova_view::table::close(&table);
    let output = table.render();
    if !output.contains("&lt;Ana&gt;") || !output.contains("<caption>") { return 11; }

    let vars = nova_view::context();
    vars.set_i64("total",42);
    vars.set_bool("active",true);
    let rendered = nova_view::render("<strong>{{ total }}</strong> {{ active }}",&vars);
    if !rendered.equals("<strong>42</strong> true") { return 12; }

    let sheet = nova_view::theme::css();
    if !sheet.contains(".nv-shell") || !sheet.contains("@media") { return 13; }

    let page = nova_view::layout::page_with_meta("Dashboard <Nova>","Painel & vendas",output.as_str(),"/app.css");
    if !page.contains("Dashboard &lt;Nova&gt;") { return 14; }
    if !page.contains("Painel &amp; vendas") { return 15; }
    println!("NovaView 0.47 OK");
    return 0;
}
