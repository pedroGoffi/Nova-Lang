// Regression: matching an owning enum payload transfers ownership precisely
// once. Inactive Result variants must not run Drop on zeroed handles.
import std;

fn produce(ok: bool) -> std::result::Result<std::string::String,std::error::OwnedError> {
    if ok { return Ok(std::string::from_text("ready")); }
    return Err(std::error::owned(409,"conflict"));
}

fn main() -> i32 {
    match produce(true) {
        Ok(value) => { if !value.equals("ready") { return 1; } }
        Err(error) => { return 2; }
    }
    match produce(false) {
        Ok(value) => { return 3; }
        Err(error) => { if error.code()!=409 { return 4; } }
    }
    let present: std::option::Option<std::string::String> = Some(std::string::from_text("x"));
    match present {
        None => { return 5; }
        Some(value) => { if !value.equals("x") { return 6; } }
    }
    let empty: std::option::Option<std::string::String> = None;
    match empty {
        Some(value) => { return 7; }
        None => { }
    }
    // Test normal scope drop for both Result variants when not pattern-bound.
    let ignored_ok: std::result::Result<std::string::String,std::error::OwnedError> = Ok(std::string::from_text("discard"));
    let ignored_err: std::result::Result<std::string::String,std::error::OwnedError> = Err(std::error::owned(418,"discard"));
    std::io::println("Ownership Option/Result: OK");
    return 0;
}
