import std;
import nexo;

use std::string;
use std::io;
use std::task;
use nexo::app::App;
use nexo::request::Request;
use nexo::response::Response;

fn setup_routes(app: &App) -> i32 {
    return app.get("/user", fn(req: Request, res: Response) -> i32 {
        return res.text("Hello from Nova");
    });
}

async fn app_mainloop() -> i64 {
    let app = nexo::create(7889) defer app.close();

    if setup_routes(&app) != 0 {
        return -1;
    }

    return app.listen(0);
}

fn main() -> i32 {
    io::native_println("Nova Nexo running at http://127.0.0.1:7889");

    let server_task: task::Task<i64> =
        task::manage(app_mainloop());

    let result: i64 = server_task.wait();

    if result < 0 { return 1; } return 0;
}
