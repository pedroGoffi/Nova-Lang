import std;
use std::io;
use std::text::regex;

fn expect(pattern: str, text: str, expected: bool) -> i32 {
    match regex::compile(pattern) {
        Ok(compiled) => {
            let actual = compiled.is_match(text);
            if actual != expected {
                io::stdout().write_line(format!("FAIL /{pattern}/ in '{text}'").as_str());
                return 1;
            }
        }
        Err(error) => {
            io::stdout().write_line(format!("invalid /{pattern}/: {error}").as_str());
            return 1;
        }
    }
    return 0;
}

fn main() -> i32 {
    let mut failures: i32 = 0;
    failures += expect("nova", "a nova language", true);
    failures += expect("^[a-zA-Z_][a-zA-Z0-9_]*$", "nova_07", true);
    failures += expect("\\d+\\s\\w+", "123 nova", true);
    failures += expect("a(b|cd)+e", "abcdbe", true);
    failures += expect("[^0-9]+", "123", false);

    if failures == 0 {
        io::stdout().write_line("regex: all examples passed");
    }
    return failures;
}
