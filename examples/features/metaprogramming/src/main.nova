import std;

// Debug and RequiredArgsConstructor
// defined in std::introspection::<debug, builder>
@Debug
@RequiredArgsConstructor
class FormatSamples {
    sigma: bool,
    magic: i64
}


fn main() -> i32 {
    let samples = FormatSamples::new(
        sigma: true,
        magic: 69420
    );
    println!("----\n{:?}\n-----", samples);
    0
}
