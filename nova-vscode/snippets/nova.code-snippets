{
  "Nova main": {"prefix": "main", "body": ["fn main() -> i32 {", "    ${1:// code}", "    return 0;", "}"], "description": "Nova entrypoint"},
  "Nova function": {"prefix": "fn", "body": ["fn ${1:name}(${2:args}) -> ${3:i32} {", "    ${4:return 0;}", "}"], "description": "Declare function"},
  "Nova public function": {"prefix": "pubfn", "body": ["pub fn ${1:name}(${2:args}) -> ${3:i32} {", "    ${4:return 0;}", "}"], "description": "Declare public function"},
  "Nova struct": {"prefix": "struct", "body": ["struct ${1:Name} { ${2:field}: ${3:i32} }"], "description": "Declare struct"},
  "Nova impl": {"prefix": "impl", "body": ["impl ${1:Type} {", "    fn ${2:method}(self: &${1:Type}) -> ${3:i32} {", "        ${4:return 0;}", "    }", "}"], "description": "Implement methods"},
  "Nova if": {"prefix": "if", "body": ["if ${1:condition} {", "    ${2:// code}", "}"], "description": "Conditional"},
  "Nova for": {"prefix": "for", "body": ["for ${1:i} in ${2:0}..${3:10} {", "    ${4:// code}", "}"], "description": "Range loop"},
  "Nova async": {"prefix": "asyncfn", "body": ["async fn ${1:name}(${2:args}) -> ${3:i32} {", "    ${4:return 0;}", "}"], "description": "Declare async function"},
  "Nova module": {"prefix": "mod", "body": ["mod ${1:name};"], "description": "Module declaration"},
  "Nova match": {"prefix": "match", "body": ["match ${1:value} {", "    ${2:Pattern} => { ${3:// code} }", "}"], "description": "Match expression"}
}
