// Contract for panic.nova: Boolean condition accepted by the invariant checker.
pub concept PanicCondition<T> = boolean<T>;

// Explicit fatal error (process abort policy, no unwinding / no RAII cleanup).
// Set NOVA_BACKTRACE=1 to include native runtime frames on Linux debug builds.
extern fn native_fail(message: str) -> ();

pub fn check(condition: bool, message: str) -> () {
    if !condition { native_fail(message); }
    return;
}

// Only for unrecoverable invariant violations. Expected failures should
// return Option<T> / Result<T,E> from the public API.
pub fn fail(message: str) -> () {
    native_fail(message);
    return;
}
