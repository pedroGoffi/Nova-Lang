use std::abi::native::libc::stdlib::getenv;
use std::abi::native::libc::stdlib::setenv;
use std::abi::native::libc::stdlib::unsetenv;
use std::core::option::Option;
use std::core::types::Word;
use std::error::error::Error;
use std::error::result::Result;
use std::system::traits::EnvironmentAccess;

pub class Variable { key: str, value: str }

impl Variable {
    static fn new(key: str, value: str) -> Self { return new Variable { key: key, value: value }; }
    fn name(self: &Variable) -> str { return self.key; }
    fn contents(self: &Variable) -> str { return self.value; }
}

pub fn variable(key: str, value: str) -> Variable { return Variable::new(key, value); }

pub struct Environment {}

impl Environment {
    static fn new() -> Self { return new Environment {}; }
    fn get(self: &Environment, key: str) -> Option<Variable> {
        unsafe {
            let address: Word = getenv(key) as Word;
            if address == 0 { return None; }
            return Some(Variable::new(key, std::core::borrow(address)));
        }
    }
    fn set(self: &Environment, key: str, value: str) -> Result<(),Error> {
        let mut status: i32 = 0;
        unsafe { status = setenv(key, value, 1); }
        if status != 0 { return Err(Error::new(status, "could not set environment variable")); }
        return Ok(());
    }
    fn remove(self: &Environment, key: str) -> Result<(),Error> {
        let mut status: i32 = 0;
        unsafe { status = unsetenv(key); }
        if status != 0 { return Err(Error::new(status, "could not remove environment variable")); }
        return Ok(());
    }
}

impl EnvironmentAccess for Environment {
    fn get(self: &Environment, key: str) -> Option<Variable> { return self.get(key); }
    fn set(self: &Environment, key: str, value: str) -> Result<(),Error> { return self.set(key, value); }
    fn remove(self: &Environment, key: str) -> Result<(),Error> { return self.remove(key); }
}

pub fn current() -> Environment { return Environment::new(); }
pub fn get(key: str) -> Option<Variable> {
    let environment: Environment = Environment::new();
    return environment.get(key);
}
pub fn set(key: str, value: str) -> Result<(),Error> {
    let environment: Environment = Environment::new();
    return environment.set(key, value);
}
pub fn remove(key: str) -> Result<(),Error> {
    let environment: Environment = Environment::new();
    return environment.remove(key);
}
