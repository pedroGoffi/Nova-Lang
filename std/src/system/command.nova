use std::abi::llvm::process_close;
use std::abi::llvm::process_eof;
use std::abi::llvm::process_open;
use std::abi::llvm::process_read_line;
use std::abi::llvm::heap_allocate;
use std::abi::llvm::heap_free;
use std::abi::native::libc::stdlib::system;
use std::core;
use std::core::types::Size;
use std::error::error::Error;
use std::error::result::Result;
use std::text::string::String;
use std::system::process::ExitCode;
use std::system::traits::ProcessControl;

// A command in shell mode. `system()` and `popen()` intentionally use the
// host shell, just like C/C++ system(). Do not concatenate untrusted input.
pub class Command { value: str, arguments: std::text::string::String }

pub struct Output { exit_status: ExitCode, captured_stdout: std::text::string::String }

impl Output {
    fn status(self: &Output) -> ExitCode { return ExitCode::new(self.exit_status.value()); }
    fn stdout(self: &Output) -> str { return self.captured_stdout.as_str(); }
    fn success(self: &Output) -> bool { return self.exit_status.is_success(); }
    // Marks Output as an owning aggregate. HIR then moves the complete enum
    // payload out of Result and releases captured_stdout with the aggregate.
    fn drop(self: Output) -> () { return; }
}

impl Command {
    static fn new(value: str) -> Self {
        return new Command { value: value, arguments: String::new() };
    }

    // Adds one argument and returns the command so calls can be chained.
    // Arguments are currently assembled for the shell-backed implementation.
    fn arg(self: &mut Command, value: str) -> &mut Command {
        self.arguments.append(" ");
        self.arguments.append(value);
        return self;
    }

    fn command(self: &Command) -> std::text::string::String { return self.shell_command(); }

    fn shell_command(self: &Command) -> std::text::string::String {
        let mut complete: std::text::string::String = String::from(self.value);
        complete.append(self.arguments.as_str());
        return complete;
    }

    // Equivalent to C/C++ system(): waits for the shell command and returns
    // its normalized exit code. A non-zero exit code is not an Error.
    fn status(self: &Command) -> Result<ExitCode,Error> {
        let complete: std::text::string::String = self.shell_command();
        let mut status: i32 = 0;
        unsafe { status = system(complete.as_str()); }
        if status < 0 { return Err(Error::new(status, "could not execute command")); }
        if (status & 127) != 0 { return Err(Error::new(status, "command terminated by signal")); }
        return Ok(ExitCode::new((status >> 8) & 255));
    }

    // Captures stdout into caller-owned storage. This form is useful when the
    // caller wants to retain and process text without moving an owning Output
    // payload out of Result.
    fn output_into(self: &Command, destination: &mut std::text::string::String) -> Result<ExitCode,Error> {
        let complete: std::text::string::String = self.shell_command();
        let stream: Size = unsafe { process_open(complete.as_str(), "r") };
        if stream == 0 {
            return Err(Error::new(-1, "could not open command output"));
        }

        let buffer: Size = unsafe { heap_allocate(8, 4096) };
        if buffer == 0 {
            unsafe { process_close(stream); }
            return Err(Error::new(-12, "could not allocate command output buffer"));
        }

        unsafe {
            while process_eof(stream) == 0 {
                let line: Size = process_read_line(buffer, 4096, stream);
                if line == 0 { break; }
                destination.append(core::borrow(buffer));
            }
        }

        let raw_status: i32 = unsafe { process_close(stream) };
        unsafe { heap_free(buffer); }
        if raw_status < 0 { return Err(Error::new(raw_status, "could not wait for command")); }
        if (raw_status & 127) != 0 {
            return Err(Error::new(raw_status, "command terminated by signal"));
        }
        return Ok(ExitCode::new((raw_status >> 8) & 255));
    }

    // Executes through the shell and captures stdout. Stderr remains attached
    // to the parent process, matching the usual popen("r") behavior.
    fn output(self: &Command) -> Result<Output,Error> {
        let complete: std::text::string::String = self.shell_command();
        let stream: Size = unsafe { process_open(complete.as_str(), "r") };
        if stream == 0 {
            return Err(Error::new(-1, "could not open command output"));
        }

        let buffer: Size = unsafe { heap_allocate(8, 4096) };
        if buffer == 0 {
            unsafe { process_close(stream); }
            return Err(Error::new(-12, "could not allocate command output buffer"));
        }

        let mut captured: std::text::string::String = String::new();
        unsafe {
            while process_eof(stream) == 0 {
                let line: Size = process_read_line(buffer, 4096, stream);
                if line == 0 { break; }
                captured.append(core::borrow(buffer));
            }
        }

        let raw_status: i32 = unsafe { process_close(stream) };
        unsafe { heap_free(buffer); }
        if raw_status < 0 {
            return Err(Error::new(raw_status, "could not wait for command"));
        }
        if (raw_status & 127) != 0 {
            return Err(Error::new(raw_status, "command terminated by signal"));
        }

        return Ok(new Output {
            exit_status: ExitCode::new((raw_status >> 8) & 255),
            captured_stdout: captured
        });
    }
}

impl ProcessControl for Command {
    fn run(self: &Command, command: str) -> Result<ExitCode,Error> {
        let command_value: Command = Command::new(command);
        return command_value.status();
    }
}

pub fn run(command: str) -> Result<ExitCode,Error> {
    let command_value: Command = Command::new(command);
    return command_value.status();
}

pub fn exec(command: str) -> Result<ExitCode,Error> {
    let command_value: Command = Command::new(command);
    return command_value.status();
}

pub fn output(command: str) -> Result<Output,Error> {
    let command_value: Command = Command::new(command);
    return command_value.output();
}
