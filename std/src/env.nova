// Contract for env.nova: Environment string value readable through a UTF-8 view.
pub concept EnvironmentText<T> = requires(T value) { { value.as_str() } -> str; };

// Nova STD env — compiled with the builtin runtime.
// Returns an owned String handle; missing keys produce an empty String.
extern fn native_get(name: str) -> u64;


// Environment variable values are owned managed strings.
pub fn read(name: str) -> std::string::String {
    return new std::string::String { handle: native_get(name) };
}
