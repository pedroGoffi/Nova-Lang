#[meta_proc_intrinsic(method)]
pub fn method(block: MetaDecl, method: MetaDecl) -> MetaDecl { return 0; }
#[comptime]
#[meta_proc_intrinsic(struct_decl)]
pub fn struct_decl(name: str) -> MetaDecl { return 0; }
#[comptime]
#[meta_proc_intrinsic(struct_field)]
pub fn struct_field(decl: MetaDecl, name: str, ty: MetaTypeRef) -> MetaDecl { return 0; }
// Attach one typed metadata attribute to a generated declaration. The
// declaration is re-entered into procedural expansion, allowing generated
// types to compose with derives and decorators without source templates.
#[comptime]
#[meta_proc_intrinsic(annotate)]
pub fn annotate(decl: MetaDecl, name: str, argument: str) -> MetaDecl { return 0; }
#[comptime]
#[meta_proc_intrinsic(declarations)]
pub fn declarations() -> MetaDecls { return 0; }
#[comptime]
#[meta_proc_intrinsic(append)]
pub fn append(decls: MetaDecls, item: MetaDecl) -> MetaDecls { return 0; }
#[comptime]
#[meta_proc_intrinsic(has_field)]
pub fn proc_has_field(target: MetaType, name: str) -> bool { return false; }
#[comptime]
#[meta_proc_intrinsic(require)]
pub fn require(condition: bool, message: str) -> bool { return false; }

// Optional metadata arguments for procedural attribute macros.
pub struct MetaArgs {}
#[comptime]
#[meta_proc_intrinsic(argument_count)]
pub fn argument_count(args: MetaArgs) -> i64 { return 0; }
#[comptime]
#[meta_proc_intrinsic(argument)]
pub fn argument(args: MetaArgs, index: i64) -> str { return ""; }


// Reusable pure-Nova procedural-macro recipes.  A package can expose its own
// #[proc_derive(...)] / #[proc_attribute(...)] wrapper that calls these helpers.
// They run in the bounded compile-time AST interpreter: no native runtime code.

// Generates `set_<field>(&mut self, value: FieldType)` for every struct field.
// No implicit copies, raw pointers or unchecked ABI word casts are emitted.
#[comptime]
pub fn generate_setters(target: MetaType) -> MetaDecl {
    let mut block = impl_for(target);
    for field in fields(target) {
        let name = field_name(field);
        let mut setter = function(
            "set_" + name,
            unit_type(),
            assign(access(variable("self"), name), variable("value"))
        );
        setter = parameter(setter, "self", mutable_reference(type_ref(target)));
        setter = parameter(setter, "value", field_type_ref(field));
        block = method(block, setter);
    }
    return block;
}

// Validates an arbitrary field list supplied to an attribute macro, entirely
// at compile time.  Empty MetaDecls means no runtime artifacts are emitted.
#[comptime]
pub fn require_fields(target: MetaType, args: MetaArgs) -> MetaDecls {
    let amount: i64 = argument_count(args);
    require(amount != 0, "RequireFields expects one or more field names");
    for index in 0..amount {
        let name = argument(args, index);
        require(proc_has_field(target, name), "missing required field: " + name);
    }
    return declarations();
}

// Derive recipe: compile-time field count as a constant-returning instance
// method. Generated impl and method are ordinary Nova; no runtime reflection.
#[comptime]
pub fn generate_field_count(target: MetaType) -> MetaDecl {
    let mut block = impl_for(target);
    let mut getter = function("nova_field_count", type_named("i64"), int_expr(meta_field_count(target)));
    getter = parameter(getter, "self", reference(type_ref(target)));
    block = method(block, getter);
    return block;
}

// Compile-time contract for consumers of a generated static-schema method.
pub concept HasStaticFieldCount<T> = has_method<T,nova_field_count>;

// AST builders used by derives. The compiler emits ordinary Nova methods.
#[comptime]
#[meta_proc_intrinsic(struct_init)]
pub fn struct_init(target: MetaType) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(init_field)]
pub fn init_field(init: MetaExpr, name: str, value: MetaExpr) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(static_method)]
pub fn static_method(decl: MetaDecl) -> MetaDecl { return 0; }

// One derive eliminates repetitive field assignments and constructor parameters.
// All generated code is checked by the ordinary Nova type checker.
#[comptime]
pub fn generate_constructor(target: MetaType) -> MetaDecl {
    let mut initializer = struct_init(target);
    for field in fields(target) {
        let name = field_name(field);
        initializer = init_field(initializer, name, variable(name));
    }
    let mut ctor = function("new", type_ref(target), initializer);
    for field in fields(target) {
        ctor = parameter(ctor, field_name(field), field_type_ref(field));
    }
    ctor = static_method(ctor);
    return method(impl_for(target),ctor);
}

#[comptime]
#[proc_derive(Constructor)]
pub fn derive_constructor(target: MetaType) -> MetaDecl {
    return generate_constructor(target);
}

#[comptime]
#[proc_derive(Setters)]
pub fn derive_setters(target: MetaType) -> MetaDecl {
    return generate_setters(target);
}

#[comptime]
#[proc_derive(FieldCount)]
pub fn derive_count(target: MetaType) -> MetaDecl {
    return generate_field_count(target);
}

// Safe-by-default read accessors: the returned field must be Copyable.
// For an owning field prefer a manually written borrow method until lifetimes
// and returned field references are verified by the ownership checker.
#[comptime]
pub fn generate_getters(target: MetaType) -> MetaDecl {
    let mut block = impl_for(target);
    for field in fields(target) {
        let name = field_name(field);
        let mut getter = function(
            "get_" + name,
            field_type_ref(field),
            access(variable("self"),name)
        );
        getter = parameter(getter,"self",reference(type_ref(target)));
        block = method(block,getter);
    }
    return block;
}

#[comptime]
#[proc_derive(Getters)]
pub fn derive_getters(target: MetaType) -> MetaDecl {
    return generate_getters(target);
}

// General-purpose AST construction for typed procedural derives; all values
// exist only at compile time and emit no runtime code.
#[comptime]
#[meta_proc_intrinsic(str_expr)]
pub fn str_expr(text: str) -> MetaExpr {return 0;}
#[comptime]
#[meta_proc_intrinsic(field_type_name)]
pub fn field_type_name(field: MetaField) -> str {return "";}
#[comptime]
#[meta_proc_intrinsic(field_family)]
pub fn field_family(field: MetaField) -> str {return "";}
#[comptime]
#[meta_proc_intrinsic(field_inner_type)]
pub fn field_inner_type(field: MetaField) -> MetaTypeRef {return 0;}
#[comptime]
#[meta_proc_intrinsic(field_inner_name)]
pub fn field_inner_name(field: MetaField) -> str {return "";}
#[comptime]
#[meta_proc_intrinsic(type_apply2)]
pub fn type_apply2(name: str, first: MetaTypeRef, second: MetaTypeRef) -> MetaTypeRef {return 0;}
#[comptime]
#[meta_proc_intrinsic(call2)]
pub fn call2(name: str, first: MetaExpr, second: MetaExpr) -> MetaExpr {return 0;}
#[comptime]
#[meta_proc_intrinsic(generic_call2)]
pub fn generic_call2(name: str, type_arg: MetaTypeRef, first: MetaExpr, second: MetaExpr) -> MetaExpr {return 0;}
#[comptime]
#[meta_proc_intrinsic(try_expr)]
pub fn try_expr(value: MetaExpr) -> MetaExpr {return 0;}

// JSON derives intentionally generate *ordinary Nova code* which calls the
// public parser and uses the normal Result `?` lowering. No C JSON builder.
#[comptime]
pub fn json_field_expression(field: MetaField, input: MetaExpr) -> MetaExpr {
    let key = str_expr(field_name(field));
    let family = field_family(field);
    let name = field_type_name(field);
    // Named primitive/STD codecs use their ordinary Nova parser functions.
    // Generic `required<T>` is reserved for user types implementing JsonDecodable;
    // a qualified String impl can otherwise be rejected during specialization.
    let mut decoder = generic_call2("std::serialization::json::required",field_type_ref(field),input,key);
    if name == "std::text::string::String" || name == "String" {
        decoder = call2("std::serialization::json::required_string",input,key);
    }
    else if name == "i64" { decoder = call2("std::serialization::json::required_i64",input,key); }
    else if name == "i32" { decoder = call2("std::serialization::json::required_i32",input,key); }
    else if name == "bool" { decoder = call2("std::serialization::json::required_bool",input,key); }
    else if name == "f64" { decoder = call2("std::serialization::json::required_f64",input,key); }
    else if name == "std::collections::vec::StringVector" || name == "StringVector" {
        decoder = call2("std::serialization::json::required_string_array",input,key);
    }
    else if family == "Option" || family == "std::core::option::Option" {
        let inner = field_inner_name(field);
        if inner == "std::text::string::String" || inner == "String" {
            decoder = call2("std::serialization::json::optional_string",input,key);
        } else {
            decoder = generic_call2("std::serialization::json::optional",field_inner_type(field),input,key);
        }
    }
    else if family == "Vec" || family == "std::collections::vec::Vec" {
        decoder = generic_call2("std::serialization::json::required_array",field_inner_type(field),input,key);
    }
    return try_expr(decoder);
}

#[comptime]
#[proc_derive(JsonDecode)]
pub fn derive_json_decode(target: MetaType) -> MetaDecl {
    let mut record = struct_init(target);
    for field in fields(target) {
        record = init_field(record,field_name(field),
            json_field_expression(field,variable("json_text")));
    }
    let result = type_apply2("std::error::result::Result",type_ref(target),
        type_named("std::serialization::json::JsonError"));
    let mut decode = function("from_json",result,call("Ok",record));
    decode = parameter(decode,"json_text",type_named("str"));
    return method(impl_for(target),static_method(decode));
}


#[comptime]
#[meta_proc_intrinsic(call0)]
pub fn call0(name: str) -> MetaExpr {return 0;}
#[comptime]
#[meta_proc_intrinsic(call3)]
pub fn call3(name: str, first: MetaExpr, second: MetaExpr, third: MetaExpr) -> MetaExpr {return 0;}
#[comptime]
#[meta_proc_intrinsic(borrow)]
pub fn borrow(value: MetaExpr) -> MetaExpr {return 0;}

#[comptime]
pub fn json_field_write(field: MetaField, writer: MetaExpr) -> MetaExpr {
    let key = str_expr(field_name(field));
    let field_expression = access(variable("self"),field_name(field));
    let family = field_family(field);
    let name = field_type_name(field);
    if name == "i64" {return call3("std::serialization::json::add_i64",writer,key,field_expression);}
    if name == "i32" {return call3("std::serialization::json::add_i32",writer,key,field_expression);}
    if name == "bool" {return call3("std::serialization::json::add_bool",writer,key,field_expression);}
    if name == "f64" {return call3("std::serialization::json::add_f64",writer,key,field_expression);}
    if name == "std::text::string::String" || name == "String" {
        return call3("std::serialization::json::add_string",writer,key,borrow(field_expression));
    }
    if name == "std::collections::vec::StringVector" || name == "StringVector" {
        return call3("std::serialization::json::add_string_vector",writer,key,borrow(field_expression));
    }
    if family == "Option" || family == "std::core::option::Option" {
        let inner = field_inner_name(field);
        if inner == "i64" {return call3("std::serialization::json::add_optional_i64",writer,key,field_expression);}
        if inner == "i32" {return call3("std::serialization::json::add_optional_i32",writer,key,field_expression);}
        if inner == "bool" {return call3("std::serialization::json::add_optional_bool",writer,key,field_expression);}
        if inner == "f64" {return call3("std::serialization::json::add_optional_f64",writer,key,field_expression);}
    }
    return call3("std::serialization::json::add_nested",writer,key,borrow(field_expression));
}

#[comptime]
#[proc_derive(JsonEncode)]
pub fn derive_json_encode(target: MetaType) -> MetaDecl {
    let mut writer = call0("std::serialization::json::begin_object");
    for field in fields(target) {
        writer = json_field_write(field,writer);
    }
    let mut method_fn = function("to_json",type_named("std::text::string::String"),
        call("std::serialization::json::end_object",writer));
    method_fn = parameter(method_fn,"self",reference(type_ref(target)));
    return method(impl_for(target),method_fn);
}

// Field annotation expansion contract: a Nova function marked
// #[comptime] #[proc_field_validator(Name)] receives (MetaField, MetaArgs)
// and returns a MetaExpr that must evaluate to bool at runtime. The compiler
// turns false into Err in a generated validate() method.
#[comptime]
#[meta_proc_intrinsic(bool_expr)]
pub fn bool_expr(value: bool) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(has_arg)]
pub fn has_arg(args: MetaArgs, name: str) -> bool { return false; }
#[comptime]
#[meta_proc_intrinsic(int_arg)]
pub fn int_arg(args: MetaArgs, name: str) -> i64 { return 0; }
#[comptime]
#[meta_proc_intrinsic(string_arg)]
pub fn string_arg(args: MetaArgs, name: str) -> str { return ""; }
#[comptime]
#[meta_proc_intrinsic(argument_key)]
pub fn argument_key(args: MetaArgs, index: i64) -> str { return ""; }

