// Nova Meta: marker traits define attribute schemas / effect vocabulary.
// Compiler verifies placement and contracts; the meaning of an attribute is
// provided by the service that consumes it. These markers generate no LLVM code.
#[meta_attribute(struct, enum, function, lint_unused)]
pub trait must_use {}
#[meta_attribute(function, lint_call)]
pub trait deprecated {}
#[meta_effect]
pub trait network {}
#[meta_effect]
pub trait filesystem {}
#[meta_effect]
pub trait database {}
#[meta_effect]
pub trait allocation {}
#[meta_effect]
pub trait blocking {}
#[meta_effect]
pub trait authentication {}
#[meta_effect]
pub trait reflection {}
#[meta_effect]
pub trait compiletime_io {}
#[meta_effect]
pub trait compiletime_spawn {}
#[meta_effect]
pub trait cancellation {}
// The existing foreach AST lowering now reads these method names from .nova.
// Receiver and cursor types are verified by ordinary method typechecking.
#[meta_protocol(foreach_begin, begin)]
pub trait ForeachBegin { fn begin(self: Self) -> Self; }
#[meta_protocol(foreach_end, end)]
pub trait ForeachEnd { fn end(self: Self) -> Self; }
#[meta_protocol(foreach_equals, equals)]
pub trait ForeachEquals { fn equals(self: Self, rhs: Self) -> bool; }
#[meta_protocol(foreach_value, value)]
pub trait ForeachValue { fn value(self: Self) -> Self; }
#[meta_protocol(foreach_advance, next)]
pub trait ForeachAdvance { fn next(self: Self) -> Self; }

// Higher-level derive recipes are authored here, not in the Rust codegen.
// Only the underlying, already safe derives are materialized by the compiler.
#[meta_derive(Clone, Debug)]
pub trait AutoInspectable {}

#[meta_derive(Default, Clone)]
pub trait AutoRecord {}

// Reusable schema: libraries can attach #[entity_record] to structs with
// the correct shape. The field name/type rules are compiler-checked AST queries.
#[meta_attribute(struct, fields_min_1, field_id, type_id_i64)]
pub trait entity_record {}

// A stricter, parameterized attribute with a dependency on entity_record.
#[meta_attribute(struct, args_exact_1, requires_entity_record)]
pub trait entity_table {}

// Framework-style decorator vocabulary. These are intentionally only schemas;
// a package can attach its own procedural processor to give them behavior.
#[meta_attribute(struct, phase_discover, priority_100)]
pub trait Component {}
#[meta_attribute(struct, phase_discover, priority_101)]
pub trait MonoBehaviour {}
#[meta_attribute(struct, phase_validate, repeatable)]
pub trait RequireComponent {}
#[meta_attribute(struct, phase_generate, priority_205)]
pub trait ExecuteAlways {}
#[meta_attribute(field, phase_validate)]
pub trait SerializeField {}
#[meta_attribute(field, phase_validate)]
pub trait HideInInspector {}
#[meta_attribute(struct, phase_discover, priority_110)]
pub trait sdlefGame {}
#[meta_attribute(struct, phase_discover, priority_111)]
pub trait sdlefGame2D {}
#[meta_attribute(function, phase_generate, priority_210)]
pub trait sdlefStart {}
#[meta_attribute(function, phase_generate, priority_220)]
pub trait sdlefLoop {}
#[meta_attribute(function, phase_generate, priority_220)]
pub trait sdlefUpdate {}
#[meta_attribute(function, phase_generate, priority_230)]
pub trait sdlefRender {}
#[meta_attribute(function, phase_generate, priority_200)]
pub trait otherComponent {}
#[meta_attribute(parameter, phase_validate, repeatable)]
pub trait Valid {}
#[meta_attribute(parameter, phase_validate, repeatable)]
pub trait OtherOne {}
#[meta_attribute(return_type)]
pub trait More {}

#[meta_attribute(struct, conflicts_entity_table)]
pub trait transient_entity {}

// Derive implementations are normal Nova trait defaults. Their optional
// concept requirements are verified by the same solver used for generics.
// A package may #[derive(HasNumericId)] on a struct with an `id` field.
pub concept HasIdentifier<T> = has_field<T, id>;
#[meta_derive_impl(HasIdentifier)]
pub trait HasNumericId {
    fn identifier(self: &Self) -> i64 { return self.id; }
}

// Reflection primitives are declared here. Their bodies are never used:
// the compile-time interpreter must replace every call before codegen.
// This is the minimal trusted introspection ABI; higher-level derive logic
// is written in Nova libraries, not as a new Rust intrinsic per derive.
#[pure]
#[meta_intrinsic(field_count)]
pub fn field_count<T>() -> i64 { return 0; }
#[pure]
#[meta_intrinsic(has_field)]
pub fn has_field<T>(name: str) -> bool { return false; }
#[pure]
#[meta_intrinsic(type_name)]
pub fn type_name<T>() -> str { return ""; }
#[pure]
#[meta_intrinsic(field_type)]
pub fn field_type<T>(name: str) -> str { return ""; }

// Enum and kind reflection use the same read-only compile-time protocol.
#[pure]
#[meta_intrinsic(type_kind)]
pub fn type_kind<T>() -> str { return ""; }
#[pure]
#[meta_intrinsic(variant_count)]
pub fn variant_count<T>() -> i64 { return 0; }
#[pure]
#[meta_intrinsic(has_variant)]
pub fn has_variant<T>(name: str) -> bool { return false; }

// Typed procedural macro AST ABI. All functions below are compile-time-only
// intrinsics; their implementations live in the compiler's generic AST VM,
// never in the native executable. Packages implement *transformations* in Nova.
// The marker types are not runtime reflection objects.
pub struct MetaType {}
// Whole-program compile-time capability. This is a read-only compiler handle
// to the current package/dependency source graph; it never becomes a runtime
// value and it cannot perform host I/O or arbitrary source-string execution.
pub struct MetaProgram {}
// Compiler-backed class description. It is a compile-time value, never a
// runtime object; its methods are implemented by the typed metadata VM.
pub struct MetaClass {}
pub struct MetaField {}
pub struct MetaFields {}
pub struct MetaMethods {}
pub struct MetaTypes {}
pub struct MetaMethod {}
pub struct MetaTypeRef {}
pub struct MetaExpr {}
pub struct MetaDecl {}
pub struct MetaDecls {}

// High-level class editing: no manual AST assembly for a simple field.
// A decorator returning this declaration replaces its annotated class, and
// subsequent decorators observe the updated field list.
#[comptime]
#[meta_proc_intrinsic(add_field)]
pub fn add_field(target: MetaType, name: str, type_name: str) -> MetaDecl { return 0; }

#[comptime]
#[meta_proc_intrinsic(fields)]
pub fn fields(target: MetaType) -> MetaFields { return 0; }
#[comptime]
#[meta_proc_intrinsic(class_info)]
pub fn class_info(target: MetaType) -> MetaClass { return 0; }
#[comptime]
#[meta_proc_intrinsic(class_name)]
pub fn class_name(target: MetaClass) -> str { return ""; }
#[comptime]
#[meta_proc_intrinsic(class_fields)]
pub fn class_fields(target: MetaClass) -> MetaFields { return 0; }
#[comptime]
#[meta_proc_intrinsic(class_methods)]
pub fn class_methods(target: MetaClass) -> MetaMethods { return 0; }
#[comptime]
#[meta_proc_intrinsic(class_field_count)]
pub fn class_field_count(target: MetaClass) -> i64 { return 0; }
// Jai-style program control primitives. A macro can discover declarations
// across the compilation and then return MetaDecl/MetaDecls to extend it.
// Emission remains typed: generated items re-enter normal parsing, effects,
// ownership and type checking in the next generation phase.
#[comptime]
#[meta_proc_intrinsic(program)]
pub fn program() -> MetaProgram { return 0; }
#[comptime]
#[meta_proc_intrinsic(program_types)]
pub fn program_types(program: MetaProgram, annotation: str) -> MetaTypes { return 0; }
#[comptime]
#[meta_proc_intrinsic(program_type_count)]
pub fn program_type_count(program: MetaProgram, annotation: str) -> i64 { return 0; }
#[comptime]
#[meta_proc_intrinsic(program_phase)]
pub fn program_phase(program: MetaProgram) -> i64 { return 0; }
// Read-only class/method reflection for Nova-authored annotation processors.
// `impl` methods are collected before procedural expansion (including other
// source files in the same package). No runtime reflection is emitted.
#[comptime]
#[meta_proc_intrinsic(methods)]
pub fn methods(target: MetaType) -> MetaMethods { return 0; }
// Enumerate annotated classes across the loaded package dependency graph.
// Available only during procedural expansion: no runtime scanning or reflection.
#[comptime]
#[meta_proc_intrinsic(types_with_annotation)]
pub fn types_with_annotation(annotation: str) -> MetaTypes { return 0; }
#[comptime]
#[meta_proc_intrinsic(target_qualified_name)]
pub fn target_qualified_name(target: MetaType) -> str { return ""; }
// Read named arguments from an annotated class. This is reflection metadata,
// not a runtime attribute value or unsafe source-string evaluation.
#[comptime]
#[meta_proc_intrinsic(type_annotation_string)]
pub fn type_annotation_string(target: MetaType, annotation: str, key: str) -> str { return ""; }
#[comptime]
#[meta_proc_intrinsic(method_name)]
pub fn method_name(method: MetaMethod) -> str { return ""; }
// Structural precheck for HTTP callbacks; HIR validates concrete argument types.
#[comptime]
#[meta_proc_intrinsic(method_is_http_handler)]
pub fn method_is_http_handler(method: MetaMethod) -> bool { return false; }
#[comptime]
#[meta_proc_intrinsic(method_has_annotation)]
pub fn method_has_annotation(method: MetaMethod, name: str) -> bool { return false; }
#[comptime]
#[meta_proc_intrinsic(method_annotation_string)]
pub fn method_annotation_string(method: MetaMethod, annotation: str, index: i64) -> str { return ""; }
#[comptime]
#[meta_proc_intrinsic(field_has_annotation)]
pub fn field_has_annotation(field: MetaField, name: str) -> bool { return false; }
#[comptime]
#[meta_proc_intrinsic(field_annotation_string)]
pub fn field_annotation_string(field: MetaField, name: str, index: i64) -> str { return ""; }

#[comptime]
#[meta_proc_intrinsic(field_name)]
pub fn field_name(field: MetaField) -> str { return ""; }
#[comptime]
#[meta_proc_intrinsic(field_type_ref)]
pub fn field_type_ref(field: MetaField) -> MetaTypeRef { return 0; }
#[comptime]
#[meta_proc_intrinsic(field_type_matches)]
pub fn field_type_matches(field: MetaField, target: MetaType) -> bool { return false; }
#[comptime]
#[meta_proc_intrinsic(field_count)]
pub fn meta_field_count(target: MetaType) -> i64 { return 0; }
#[comptime]
#[meta_proc_intrinsic(target_name)]
pub fn target_name(target: MetaType) -> str { return ""; }
#[comptime]
#[meta_proc_intrinsic(type_ref)]
pub fn type_ref(target: MetaType) -> MetaTypeRef { return 0; }
#[comptime]
#[meta_proc_intrinsic(type_named)]
pub fn type_named(name: str) -> MetaTypeRef { return 0; }
