#[meta_proc_intrinsic(reference)]
pub fn reference(target: MetaTypeRef) -> MetaTypeRef { return 0; }
#[comptime]
#[meta_proc_intrinsic(mutable_reference)]
pub fn mutable_reference(target: MetaTypeRef) -> MetaTypeRef { return 0; }
#[comptime]
#[meta_proc_intrinsic(unit_type)]
pub fn unit_type() -> MetaTypeRef { return 0; }
#[comptime]
#[meta_proc_intrinsic(assign)]
pub fn assign(target: MetaExpr, value: MetaExpr) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(variable)]
pub fn variable(name: str) -> MetaExpr { return 0; }
// Validated qualified function name, for a typed function-pointer expression.
#[comptime]
#[meta_proc_intrinsic(path_expr)]
pub fn path_expr(path: str) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(int_expr)]
pub fn int_expr(value: i64) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(access)]
pub fn access(owner: MetaExpr, field: str) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(binary)]
pub fn binary(op: str, left: MetaExpr, right: MetaExpr) -> MetaExpr { return 0; }
