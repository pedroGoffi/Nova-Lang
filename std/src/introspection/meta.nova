#[meta_proc_intrinsic(call)]
pub fn call(name: str, argument: MetaExpr) -> MetaExpr { return 0; }
#[comptime]
#[meta_proc_intrinsic(method_call0)]
pub fn method_call0(receiver: MetaExpr, name: str) -> MetaExpr { return 0; }
