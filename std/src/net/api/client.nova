use std::core::types::Size;
use std::error::error::Error;
use std::error::result::Result;
use std::net::address::SocketAddress;
use std::net::http::HttpRequest;
use std::net::tcp::TcpStream;

// High-level HTTP operations. The caller handles Result, but never formats a
// socket descriptor or touches the native ABI.
pub fn connect(address: SocketAddress) -> Result<TcpStream,Error> {
    return TcpStream::connect(address);
}

pub fn send(stream: &TcpStream, request: &HttpRequest) -> Result<Size,Error> {
    let payload = format!("{} {} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n",
        request.method(), request.target());
    return stream.send_text(payload.as_str());
}
