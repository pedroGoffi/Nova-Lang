use std::core;
use std::memory::raw;
use std::text::text::Text;
use std::core::types::Size;
use std::core::value::Clone;
use std::core::value::Eq;
use std::core::value::Display;
use std::serialization::traits::Serialize;
use std::serialization::traits::Deserialize;
use std::text::traits::Appendable;
use std::text::traits::TextLike;

@RequiredArgsConstructor
pub class String : std::text::text::Text {}

impl String {
    //static fn new() -> String { return new std::text::string::String {}; }
    static fn with_capacity(bytes: Size) -> Self {
        let mut result: String = String::new();
        result.reserve(bytes);
        return result;
    }
    static fn from(value: str) -> Self {
        let mut result: String = String::new();
        result.append(value);
        return result;
    }
    // Converts one Unicode scalar value to its UTF-8 byte sequence.
    static fn from_char(value: char) -> Self {
        let code: u32 = value as u32;
        let mut result: String = String::with_capacity(4);
        let mut count: Size = 0;

        unsafe {
            if code <= 127 {
                let first: *mut u8 = raw::element_at::<u8>(result.data, 0);
                *first = code as u8;
                count = 1;
            } else if code <= 2047 {
                let first: *mut u8 = raw::element_at::<u8>(result.data, 0);
                let second: *mut u8 = raw::element_at::<u8>(result.data, 1);
                *first = (192 + (code / 64)) as u8;
                *second = (128 + (code % 64)) as u8;
                count = 2;
            } else if code <= 65535 {
                let first: *mut u8 = raw::element_at::<u8>(result.data, 0);
                let second: *mut u8 = raw::element_at::<u8>(result.data, 1);
                let third: *mut u8 = raw::element_at::<u8>(result.data, 2);
                *first = (224 + (code / 4096)) as u8;
                *second = (128 + ((code / 64) % 64)) as u8;
                *third = (128 + (code % 64)) as u8;
                count = 3;
            } else {
                let first: *mut u8 = raw::element_at::<u8>(result.data, 0);
                let second: *mut u8 = raw::element_at::<u8>(result.data, 1);
                let third: *mut u8 = raw::element_at::<u8>(result.data, 2);
                let fourth: *mut u8 = raw::element_at::<u8>(result.data, 3);

                *first = (240 + (code / 262144)) as u8;
                *second = (128 + ((code / 4096) % 64)) as u8;
                *third = (128 + ((code / 64) % 64)) as u8;
                *fourth = (128 + (code % 64)) as u8;
                count = 4;
            }

            result.length = count;

            let terminator: *mut u8 = raw::element_at::<u8>(result.data, count);
            *terminator = 0;
        }

        return result;
    }
    // Construct an owned Nova String from a conventional NUL-terminated C string.
    static fn from_cstr(value: *const u8) -> Self {
        let count: Size = std::text::cstr::length(value);
        let mut result: String = String::with_capacity(count);
        unsafe {
            core::copy(result.data, value, count);
            result.length = count;
            let terminator: *mut u8 = raw::element_at::<u8>(result.data, count);
            *terminator = 0;
        }
        return result;
    }
    fn append(self: &mut String, value: str) -> () {
        let count: Size = core::text_size(value);
        if self.length + count + 1 > self.capacity {
            let mut target: Size = self.capacity;
            if target == 0 { target = 8; }
            while target < self.length + count + 1 { target *= 2; }
            unsafe { self.data = raw::reallocate_elements::<u8>(self.data, self.capacity, target); }
            self.capacity = target;
        }
        unsafe {
            core::copy(raw::element_at::<u8>(self.data, self.length),
                core::address(value) as (*const u8), count);
            self.length += count;
            let terminator: *mut u8 = raw::element_at::<u8>(self.data, self.length);
            *terminator = 0;
        }
    }
    fn as_str(self: &String) -> str {
        if self.capacity == 0 { return ""; }
        return unsafe { core::borrow(self.data as Size) };
    }
    // Consuming overload used by expressions such as
    // `writer.write_line(format!("...").as_str())`. The temporary remains
    // usable for the enclosing call. Copying also keeps the view valid after
    // the consumed String is dropped by the expression lowering.
    fn as_str(self: String) -> str {
        if self.capacity == 0 { return ""; }
        let copy: *mut u8 = unsafe { raw::alloc_elements::<u8>(self.length + 1) };
        unsafe { core::copy(copy, self.data as (*const u8), self.length + 1); }
        return unsafe { core::borrow(copy as Size) };
    }
    fn len(self: &String) -> Size { return self.length; }
    fn byte_at(self: &String, index: Size) -> u8 {
        if index >= self.length { return 0; }
        unsafe { return *raw::element_at::<u8>(self.data, index); }
    }
    // Returns an owned copy of a byte range. The returned String is always
    // NUL-terminated and can safely be exposed as a borrowed C-compatible view.
    fn substring(self: &String, start: Size, count: Size) -> String {
        if start > self.length || count > self.length - start || count == 0 {
            return String::new();
        }
        let mut result: String = String::with_capacity(count);
        unsafe {
            core::copy(result.data, raw::element_at::<u8>(self.data, start) as (*const u8), count);
            result.length = count;
            let terminator: *mut u8 = raw::element_at::<u8>(result.data, count);
            *terminator = 0;
        }
        return result;
    }
    fn backspace(self: &mut String) -> () {
        if self.length == 0 { return; }
        self.length -= 1;
        unsafe {
            let terminator: *mut u8 = raw::element_at::<u8>(self.data, self.length);
            *terminator = 0;
        }
        return;
    }
    fn is_empty(self: &String) -> bool { return self.length == 0; }
    fn clone(self: &String) -> String { return String::from(self.as_str()); }
    fn to_string(self: &String) -> str { return self.as_str(); }
    fn drop(self: String) -> () {
        unsafe { raw::deallocate_bytes(self.data); }
        return;
    }

    fn isspace_at(self: &String, index: Size) -> bool
    {
        with(self.byte_at(index)) {
            return it == ' '
            || it == '\t'
            || it == '\n'
            // TODO|| it == '\v'
            // TODO|| it == '\f'
            // TODO|| it == '\r'
            ;
        }
    }

    fn eq_ref(self: &String, other: &String) -> bool {
        if self.len() != other.len() {
            return false;
        }

        let mut index: u64 = 0;

        while index < self.len() {
            if self.byte_at(index) != other.byte_at(index) {
                return false;
            }

            index += 1;
        }

        return true;
    }
}

impl TextLike for String {
    fn as_str(self: &String) -> str { return self.as_str(); }
    fn len(self: &String) -> Size { return self.len(); }
    fn is_empty(self: &String) -> bool { return self.is_empty(); }
}

impl Appendable for String {
    fn append(self: &mut String, value: str) -> () { self.append(value); return; }
}

pub fn new_string() -> String { return String::new(); }
pub fn from_text(value: str) -> String { return String::from(value); }
pub fn from_char(value: char) -> String { return String::from_char(value); }
pub fn owned_text(value: str) -> impl TextLike { return String::from(value); }
pub fn text_length(value: str) -> Size { return core::text_size(value); }
// Cross-module callers use these free functions so the receiver keeps its
// fully-qualified String owner during specialization.
pub fn append_text(output: &mut String, value: str) -> () {
    (*output).append(value);
    return;
}
pub fn clone_text(value: &String) -> String { return (*value).clone(); }
pub fn as_text(value: &String) -> str {
    if (*value).capacity == 0 { return ""; }
    return unsafe { core::borrow((*value).data as Size) };
}

// Compiler lowering helpers for format!. They are ordinary std functions;
// format! only selects them according to the statically known value type.
pub fn format_add_text(base: String, value: str) -> String {
    let mut result: String = base;
    result.append(value);
    return result;
}

fn decimal_digit(value: i64) -> str {
    if value == 0 { return "0"; }
    if value == 1 { return "1"; }
    if value == 2 { return "2"; }
    if value == 3 { return "3"; }
    if value == 4 { return "4"; }
    if value == 5 { return "5"; }
    if value == 6 { return "6"; }
    if value == 7 { return "7"; }
    if value == 8 { return "8"; }
    return "9";
}

// Numeric formatter used by typed format!. This stays in Nova and does not
// introduce an unchecked libc formatting boundary.
pub fn format_add_i64(base: String, value: i64) -> String {
    let mut result: String = base;
    let mut number: i64 = value;
    if number < 0 {
        result.append("-");
        number = -number;
    }
    let mut divisor: i64 = 1;
    while number / divisor >= 10 { divisor *= 10; }
    while divisor > 0 {
        result.append(decimal_digit((number / divisor) % 10));
        divisor /= 10;
    }
    return result;
}

pub fn format_add_bool(base: String, value: bool) -> String {
    if value { return format_add_text(base, "true"); }
    return format_add_text(base, "false");
}

fn decimal_digit_u64(value: u64) -> str {
    if value == 0 { return "0"; }
    if value == 1 { return "1"; }
    if value == 2 { return "2"; }
    if value == 3 { return "3"; }
    if value == 4 { return "4"; }
    if value == 5 { return "5"; }
    if value == 6 { return "6"; }
    if value == 7 { return "7"; }
    if value == 8 { return "8"; }
    return "9";
}

pub fn format_add_u64(base: String, value: u64) -> String {
    let mut result: String = base;
    let mut divisor: u64 = 1;
    while value / divisor >= 10 { divisor *= 10; }
    while divisor > 0 {
        result.append(decimal_digit_u64((value / divisor) % 10));
        divisor /= 10;
    }
    return result;
}

pub fn format_add_float(base: String, value: f64, precision: i32) -> String {
    let mut result: String = base;
    let mut number: f64 = value;
    if number < 0.0 {
        result.append("-");
        number = -number;
    }
    let whole: i64 = number as i64;
    let mut divisor: i64 = 1;
    while whole / divisor >= 10 { divisor *= 10; }
    while divisor > 0 {
        result.append(decimal_digit((whole / divisor) % 10));
        divisor /= 10;
    }
    let digits: i32 = if precision < 0 { 6 } else { precision };
    if digits == 0 { return result; }
    result.append(".");
    let mut fraction: f64 = number - (whole as f64);
    let mut index: i32 = 0;
    while index < digits {
        fraction *= 10.0;
        let digit: i64 = fraction as i64;
        result.append(decimal_digit(digit));
        fraction -= digit as f64;
        index += 1;
    }
    return result;
}

pub fn format_add_owned(base: String, value: String) -> String {
    let mut result: String = base;
    append_text(&mut result, as_text(&value));
    return result;
}

impl Eq for String {
    fn equals(self: &String, other: &String) -> bool {
        return self.eq_ref(other);
    }
}

impl Clone for String {
    fn clone(self: &String) -> String { return self.clone(); }
}

impl Display for String {
    fn to_string(self: &String) -> str { return self.as_str(); }
}

impl Serialize for String {
    fn serialize(self: &String) -> str { return self.as_str(); }
}

impl Deserialize for String {
    static fn deserialize(value: str) -> String { return String::from(value); }
}
