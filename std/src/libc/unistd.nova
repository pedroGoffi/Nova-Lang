// Contract for libc/unistd.nova: POSIX descriptor passed to read and write.
pub concept CFileDescriptor<T> = same_as<T,i32>;

// <unistd.h> POSIX/Linux LP64 subset (not Windows libc).
[[unsafe]] pub extern fn read(descriptor: i32, buffer: *mut u8, size: usize) -> isize;
[[unsafe]] pub extern fn write(descriptor: i32, buffer: *const u8, size: usize) -> isize;
[[unsafe]] pub extern fn close(descriptor: i32) -> i32;
[[unsafe]] pub extern fn getpid() -> i32;
[[unsafe]] pub extern fn getppid() -> i32;
[[unsafe]] pub extern fn sleep(seconds: u32) -> u32;
[[unsafe]] pub extern fn usleep(microseconds: u32) -> i32;
[[unsafe]] pub extern fn dup(descriptor: i32) -> i32;
[[unsafe]] pub extern fn dup2(original_descriptor: i32, replacement_descriptor: i32) -> i32;
[[unsafe]] pub extern fn access(path: str, mode: i32) -> i32;
[[unsafe]] pub extern fn unlink(path: str) -> i32;
[[unsafe]] pub extern fn rmdir(path: str) -> i32;
[[unsafe]] pub extern fn chdir(path: str) -> i32;
[[unsafe]] pub extern fn getcwd(buffer: *mut u8, size: usize) -> *mut u8;
