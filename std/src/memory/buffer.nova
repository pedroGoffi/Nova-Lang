extern fn native_buffer_new(size: u64) -> u64;
extern fn native_buffer_drop(handle: u64) -> ();
extern fn native_buffer_len(handle: u64) -> u64;
extern fn native_buffer_capacity(handle: u64) -> u64;
extern fn native_buffer_resize(handle: u64, size: u64) -> ();
extern fn native_buffer_read(handle: u64, index: u64) -> u8;
extern fn native_buffer_write(handle: u64, index: u64, value: u8) -> ();
extern fn native_buffer_fill(handle: u64, value: u8) -> ();
extern fn native_buffer_copy(destination_handle: u64, destination_offset: u64,
    source_handle: u64, source_offset: u64, byte_count: u64) -> ();
extern fn native_live_resources() -> u64;

use std::core::option::Option;
use std::error::error::Error;
use std::error::result::Result;

pub struct ByteBuffer { handle: u64 }

pub fn new_buffer(byte_count: u64) -> Result<ByteBuffer,Error> {
    let handle: u64 = native_buffer_new(byte_count);
    if handle == 0 { return Err(Error::new(-12, "could not allocate native buffer")); }
    return Ok(new ByteBuffer { handle: handle });
}

impl ByteBuffer {
    fn len(self: &ByteBuffer) -> u64 { return native_buffer_len(self.handle); }
    fn capacity(self: &ByteBuffer) -> u64 { return native_buffer_capacity(self.handle); }
    fn resize(self: &ByteBuffer, byte_count: u64) -> Result<(),Error> {
        native_buffer_resize(self.handle, byte_count); return Ok(());
    }
    fn read(self: &ByteBuffer, index: u64) -> Option<u8> {
        if index >= self.len() { return None; }
        return Some(native_buffer_read(self.handle, index));
    }
    fn write(self: &ByteBuffer, index: u64, value: u8) -> Result<(),Error> {
        if index >= self.capacity() { return Err(Error::new(-22, "buffer index out of bounds")); }
        native_buffer_write(self.handle, index, value); return Ok(());
    }
    fn fill(self: &ByteBuffer, value: u8) -> Result<(),Error> {
        native_buffer_fill(self.handle, value); return Ok(());
    }
    fn copy_from(self: &ByteBuffer, destination_offset: u64,
        source: &ByteBuffer, source_offset: u64, byte_count: u64) -> Result<(),Error> {
        if destination_offset + byte_count > self.capacity() {
            return Err(Error::new(-22, "destination range exceeds buffer capacity"));
        }
        if source_offset + byte_count > source.len() {
            return Err(Error::new(-22, "source range exceeds buffer length"));
        }
        native_buffer_copy(self.handle, destination_offset, source.handle,
            source_offset, byte_count); return Ok(());
    }
    fn drop(self: ByteBuffer) -> () {
        native_buffer_drop(self.handle); return;
    }
}
