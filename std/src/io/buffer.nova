use std::memory::raw;
use std::core::types::Size;
use std::memory::traits::Buffer;
use std::core::option::Option;
use std::error::error::Error;
use std::error::result::Result;

pub class ByteBuffer { data: *mut u8, length: Size, capacity: Size }

impl ByteBuffer {
    static fn new(capacity: Size) -> Self {
        unsafe {
            return new ByteBuffer {
                data: raw::alloc_elements::<u8>(capacity), length: 0, capacity: capacity
            };
        }
    }
    static fn try_new(capacity: Size) -> Result<ByteBuffer,Error> {
        return Ok(ByteBuffer::new(capacity));
    }
    fn len(self: &ByteBuffer) -> Size { return self.length; }
    fn capacity(self: &ByteBuffer) -> Size { return self.capacity; }
    [[unsafe]] fn data_ptr(self: &ByteBuffer) -> *mut u8 { return self.data; }
    fn clear(self: &mut ByteBuffer) -> () { self.length = 0; return; }
    [[unsafe]] fn read(self: &ByteBuffer, index: Size) -> Option<u8> {
        if index >= self.length { return None; }
        unsafe { return Some(*(raw::element_at::<u8>(self.data, index))); }
    }
    [[unsafe]] fn write(self: &mut ByteBuffer, index: Size, value: u8) -> Result<(),Error> {
        if index >= self.capacity { return Err(Error::new(-22, "buffer index out of bounds")); }
        let slot: *mut u8 = raw::element_at::<u8>(self.data, index);
        unsafe { *slot = value; }
        if index >= self.length { self.length = index + 1; }
        return Ok(());
    }
    fn drop(self: ByteBuffer) -> () {
        unsafe { raw::deallocate_bytes(self.data); }
        return;
    }
}

impl Buffer for ByteBuffer {
    fn len(self: &ByteBuffer) -> Size { return self.length; }
    fn capacity(self: &ByteBuffer) -> Size { return self.capacity; }
}
