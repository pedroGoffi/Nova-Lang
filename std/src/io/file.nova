use std::abi::llvm::close_fd;
use std::abi::llvm::open_at;
use std::abi::llvm::read_fd;
use std::abi::llvm::write_bytes;
use std::io::reader::Reader;
use std::io::writer::Writer;
use std::error::error::Error;
use std::error::result::Result;
use std::core;
use std::core::types::Size;

pub const READ: i32 = 0;
pub const WRITE: i32 = 1;
pub const CREATE: i32 = 64;
pub const TRUNCATE: i32 = 512;

pub class File { descriptor: i32 }

impl File {
    static fn open(path: str, flags: i32, mode: i32) -> Result<File,Error> {
        let mut descriptor: i32 = 0;
        unsafe { descriptor = open_at(-100, path, flags, mode); }
        if descriptor < 0 { return Err(Error::new(descriptor, "could not open file")); }
        return Ok(new File { descriptor: descriptor });
    }
    fn reader(self: &File) -> Result<Reader,Error> {
        return Ok(Reader::new(self.descriptor));
    }
    fn writer(self: &File) -> Result<Writer,Error> {
        return Ok(Writer::new(self.descriptor));
    }
    fn close(self: File) -> Result<(),Error> {
        let mut status: i32 = 0;
        unsafe { status = close_fd(self.descriptor); }
        if status < 0 { return Err(Error::new(status, "could not close file")); }
        return Ok(());
    }
}

// Whole-file helpers keep descriptor ownership inside std::io. They return
// the host byte count or a negative OS error code.
pub fn read_into(path: str, destination: *mut u8, capacity: Size) -> i64 {
    let descriptor = unsafe { open_at(-100, path, READ, 0) };
    if descriptor < 0 { return descriptor as i64; }
    let count = unsafe { read_fd(descriptor, destination, capacity) };
    unsafe { close_fd(descriptor); }
    return count;
}

pub fn write_all(path: str, value: str) -> i64 {
    let descriptor = unsafe { open_at(-100, path, WRITE | CREATE | TRUNCATE, 420) };
    if descriptor < 0 { return descriptor as i64; }
    let count = unsafe { write_bytes(descriptor, core::address(value), core::text_size(value)) };
    unsafe { close_fd(descriptor); }
    return count;
}
