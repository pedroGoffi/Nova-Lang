// Atomic boolean backed by a native one-byte atomic object.
pub class AtomicBool { value: u8 }

impl AtomicBool
{
    static fn new(value: bool) -> Self
    {
        let mut initial: u8 = 0;
        if value { initial = 1; }
        return new AtomicBool { value: initial };
    }

    fn load(self: &AtomicBool, ordering: MemoryOrdering) -> bool
    {
        unsafe {
            return __nova_atomic_bool_load(
                &self.value as (*const u8) as (*mut u8), ordering_code(ordering)
            );
        }
    }

    fn store(self: &AtomicBool, value: bool, ordering: MemoryOrdering) -> ()
    {
        unsafe {
            __nova_atomic_bool_store(
                &self.value as (*const u8) as (*mut u8), value, ordering_code(ordering)
            );
        }
        return;
    }

    fn swap(self: &AtomicBool, value: bool, ordering: MemoryOrdering) -> bool
    {
        unsafe {
            return __nova_atomic_bool_swap(
                &self.value as (*const u8) as (*mut u8), value, ordering_code(ordering)
            );
        }
    }

    fn compare_exchange(
        self: &AtomicBool, expected: bool, desired: bool,
        success_ordering: MemoryOrdering, failure_ordering: MemoryOrdering
    ) -> bool
    {
        unsafe {
            return __nova_atomic_bool_compare_exchange(
                &self.value as (*const u8) as (*mut u8), expected, desired,
                ordering_code(success_ordering), ordering_code(failure_ordering)
            );
        }
    }

    fn is_lock_free(self: &AtomicBool) -> bool
    {
        unsafe {
            return __nova_atomic_bool_is_lock_free(
                &self.value as (*const u8) as (*mut u8)
            );
        }
    }

    fn get_mut(self: &mut AtomicBool) -> &mut u8
    {
        return &mut self.value;
    }
}

// Native integer atomics. These are genuinely atomic and do not use a spinlock.
pub class AtomicI8 { value: i8 }
impl AtomicI8
{
    static fn new(value: i8) -> Self { return new AtomicI8 { value: value }; }
    fn load(self: &AtomicI8, ordering: MemoryOrdering) -> i8 {
        unsafe { return __nova_atomic_i8_load(&self.value as (*const i8) as (*mut i8), ordering_code(ordering)); }
    }
    fn store(self: &AtomicI8, value: i8, ordering: MemoryOrdering) -> () {
        unsafe { __nova_atomic_i8_store(&self.value as (*const i8) as (*mut i8), value, ordering_code(ordering)); }
        return;
    }
    fn swap(self: &AtomicI8, value: i8, ordering: MemoryOrdering) -> i8 {
        unsafe { return __nova_atomic_i8_swap(&self.value as (*const i8) as (*mut i8), value, ordering_code(ordering)); }
    }
    fn compare_exchange(self: &AtomicI8, expected: i8, desired: i8, success: MemoryOrdering, failure: MemoryOrdering) -> bool {
        unsafe { return __nova_atomic_i8_compare_exchange(&self.value as (*const i8) as (*mut i8), expected, desired, ordering_code(success), ordering_code(failure)); }
    }
    fn is_lock_free(self: &AtomicI8) -> bool {
        unsafe { return __nova_atomic_i8_is_lock_free(&self.value as (*const i8) as (*mut i8)); }
    }
    fn get_mut(self: &mut AtomicI8) -> &mut i8 { return &mut self.value; }
}

