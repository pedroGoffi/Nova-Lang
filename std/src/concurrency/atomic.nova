// Atomic pointer. Pointer values are never dereferenced by the C runtime.
pub class AtomicPtr<T> { value: *mut T }
impl<T> AtomicPtr<T>
{
    static fn new(value: *mut T) -> Self { return new AtomicPtr<T> { value: value }; }
    fn load(self: &AtomicPtr<T>, ordering: MemoryOrdering) -> *mut T {
        unsafe { return __nova_atomic_ptr_load(&self.value as (*const u8) as (*mut u8), ordering_code(ordering)) as (*mut T); }
    }
    fn store(self: &AtomicPtr<T>, value: *mut T, ordering: MemoryOrdering) -> () {
        unsafe { __nova_atomic_ptr_store(&self.value as (*const u8) as (*mut u8), value as (*mut u8), ordering_code(ordering)); }
        return;
    }
    fn swap(self: &AtomicPtr<T>, value: *mut T, ordering: MemoryOrdering) -> *mut T {
        unsafe { return __nova_atomic_ptr_swap(&self.value as (*const u8) as (*mut u8), value as (*mut u8), ordering_code(ordering)) as (*mut T); }
    }
    fn compare_exchange(self: &AtomicPtr<T>, expected: *mut T, desired: *mut T, success: MemoryOrdering, failure: MemoryOrdering) -> bool {
        unsafe { return __nova_atomic_ptr_compare_exchange(&self.value as (*const u8) as (*mut u8), expected as (*mut u8), desired as (*mut u8), ordering_code(success), ordering_code(failure)); }
    }
    fn is_lock_free(self: &AtomicPtr<T>) -> bool {
        unsafe { return __nova_atomic_ptr_is_lock_free(&self.value as (*const u8) as (*mut u8)); }
    }
}

// Generic synchronized cell. This is a yielding spinlock, NOT a lock-free
// atomic operation. Use AtomicI32/AtomicI64/etc. for native atomic values.
pub class Atomic<T>
{
    value: T,
    locked: AtomicBool
}

impl<T> Atomic<T>
{
    static fn new(value: T) -> Self
    {
        return new Atomic<T> { value: value, locked: AtomicBool::new(false) };
    }

    fn is_locked(self: &Atomic<T>) -> bool
    {
        return self.locked.load(MemoryOrdering::Relaxed);
    }

    fn try_lock(self: &Atomic<T>) -> bool
    {
        return self.locked.compare_exchange(
            false, true, MemoryOrdering::Acquire, MemoryOrdering::Relaxed
        );
    }

    fn lock(self: &Atomic<T>) -> ()
    {
        while !self.try_lock() {
            thread::yield_now();
        }
        return;
    }

    fn unlock(self: &Atomic<T>) -> ()
    {
        self.locked.store(false, MemoryOrdering::Release);
        return;
    }

    // Safe scoped access. defer guarantees unlock on normal return and early
    // return paths supported by Nova's scope cleanup lowering.
    fn with_lock<R>(self: &Atomic<T>, callback: fn(&mut T) -> R) -> R
    {
        self.lock();
        defer self.unlock();
        unsafe {
            return callback(self.get_unchecked_mut());
        }
    }

    // The caller MUST hold this Atomic<T>'s lock for the entire returned
    // reference lifetime. This is unsafe because Nova has no lifetime-bearing
    // lock-guard type yet.
    [[unsafe]] fn get_unchecked_mut(self: &Atomic<T>) -> &mut T
    {
        // Keep the raw pointer in an addressable local. HIR borrow lowering
        // can project through `*pointer`, but cannot currently resolve a
        // dereference whose operand is an inline cast expression.
        unsafe {
            let pointer: *mut T = (&self.value as (*const T)) as (*mut T);
            return &mut *pointer;
        }
    }

    // Exclusive access that does not require taking the lock.
    fn get_mut(self: &mut Atomic<T>) -> &mut T
    {
        return &mut self.value;
    }
}
