use std::concurrency::thread;

// Memory-ordering values shared with runtime/nova_atomics.c.
pub enum MemoryOrdering
{
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst
}

pub comptime const OrdRelaxed: i32 = 0;
pub comptime const OrdAcquire: i32 = 1;
pub comptime const OrdRelease: i32 = 2;
pub comptime const OrdAcqRel: i32 = 3;
pub comptime const OrdSeqCst: i32 = 4;

fn ordering_code(ordering: MemoryOrdering) -> i32
{
    match ordering
    {
        MemoryOrdering::Relaxed => { return OrdRelaxed; }
        MemoryOrdering::Acquire => { return OrdAcquire; }
        MemoryOrdering::Release => { return OrdRelease; }
        MemoryOrdering::AcqRel => { return OrdAcqRel; }
        MemoryOrdering::SeqCst => { return OrdSeqCst; }
    }
}

// Native runtime bindings. The compiler links runtime/nova_atomics.c only
// when one of these symbols is reachable from the final program.
extern fn __nova_atomic_bool_load(address: *mut u8, ordering: i32) -> bool;
extern fn __nova_atomic_bool_store(address: *mut u8, value: bool, ordering: i32) -> ();
extern fn __nova_atomic_bool_swap(address: *mut u8, value: bool, ordering: i32) -> bool;
extern fn __nova_atomic_bool_compare_exchange(
    address: *mut u8, expected: bool, desired: bool,
    success_ordering: i32, failure_ordering: i32
) -> bool;
extern fn __nova_atomic_bool_is_lock_free(address: *mut u8) -> bool;

