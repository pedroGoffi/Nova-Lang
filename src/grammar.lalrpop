grammar;

use crate::ast::{Program, Item, Function, ExternFunction, Struct, Enum, Variant, Impl, Attribute, Field, Param, Stmt, MatchArm, Pattern, Expr, UnaryOp, BinaryOp, TypeRef, FunctionMode, MacroDef, TypeAlias, CompileTimeConst, Trait, TraitRestriction, TraitMethod, Concept, ConceptExpr, Requirement, ConceptBound, MacroParam, MacroFragment, MacroBody, MacroArm, MacroRepetition, MacroConcept};

pub Program: Program = { <items:Item*> => Program { items } };
Item: Item = {
    // Both declaration orders are accepted:
    //   pub #[derive(Clone)] struct X { ... }
    //   #[derive(Clone)] pub struct X { ... }
    // Attributes apply to the declaration, and visibility wraps the item.
    "pub" <item:UnpublishedItem> => Item::Public(Box::new(item)),
    <attributes:Attribute+> "pub" <s:StructDef> => {
        let mut flags=s.attributes.clone();flags.extend(attributes);
        Item::Public(Box::new(Item::Struct(Struct { attributes:flags, ..s })))
    },
    <attributes:Attribute+> "pub" <e:EnumDef> =>
        Item::Public(Box::new(Item::Enum(Enum { attributes, ..e }))),
    <attributes:Attribute+> "pub" <t:TraitDef> =>
        Item::Public(Box::new(Item::Trait(Trait {attributes,..t}))),
    <attributes:Attribute+> "pub" <f:FunctionBase> =>
        Item::Public(Box::new(Item::Function(Function { attributes, ..f }))),
    <attributes:Attribute+> "pub" <f:ExternFunctionBase> =>
        Item::Public(Box::new(Item::Extern(ExternFunction { attributes, ..f }))),
    UnpublishedItem,
};
UnpublishedItem: Item = {
    <attributes:Attribute*> <s:StructDef> => {
        let mut flags=s.attributes.clone();flags.extend(attributes);
        Item::Struct(Struct { attributes:flags, ..s })
    },
    <attributes:Attribute*> <e:EnumDef> => Item::Enum(Enum { attributes, ..e }),
    // Rust-style declarative rules: first matching AST fragment arm wins.
    "macro_rules" "!" <name:MemberIdent> "{" <arms:MacroArmRule*> "}"
        => Item::Macro(MacroDef { name, arms }),
    "macro" <name:Ident> "(" <params:Comma<MacroParamDef>> ")" "=>" <body:Expr> ";"
        => Item::Macro(MacroDef { name, arms: vec![MacroArm {params,body:MacroBody::Expression(body)}] }),
    "macro" <name:Ident> "(" <params:Comma<MacroParamDef>> ")" "=>" <body:Block>
        => Item::Macro(MacroDef { name, arms: vec![MacroArm {params,body:MacroBody::Statements(body)}] }),
    // These are module-level values, not mutable static storage. They are
    // evaluated at compile time and substituted before HIR/LLVM lowering.
    "comptime" "const" <name:Ident> ":" <ty:Type> "=" <value:Expr> ";"
        => Item::CompileTimeConst(CompileTimeConst { name, ty, value }),
    "const" <name:Ident> ":" <ty:Type> "=" <value:Expr> ";"
        => Item::CompileTimeConst(CompileTimeConst { name, ty, value }),
    "typedef" <name:Ident> "=" <target:Type> ";" => Item::TypeAlias(TypeAlias { name, target }),
    "static_assert" "(" <predicate:ConceptOr> ")" ";" => Item::ConceptAssert(predicate),
    "concept" <name:Ident> "<" <generics:NonEmptyComma<Ident>> ">" "=" <predicate:ConceptOr> ";"
        => Item::Concept(Concept {name,generics,predicate}),
    // The lexer combines adjacent `>` and `=` into `>=`. Within a concept
    // declaration it means a generic closer followed by the definition `=`.
    "concept" <name:Ident> "<" <generics:NonEmptyComma<Ident>> ">=" <predicate:ConceptOr> ";"
        => Item::Concept(Concept {name,generics,predicate}),
    <attributes:Attribute*> <t:TraitDef>
        => Item::Trait(Trait {attributes,..t}),
    <f:Function> => Item::Function(f),
    <f:ExternFunction> => Item::Extern(f),
    "namespace" <name:MemberIdent> "{" <items:Item*> "}" => Item::Namespace {name,items},
    "impl" <generic_info:GenericHeader?> <target:Type> <where_bounds:WhereConcepts> "{" <associated_types:AssociatedTypeBinding*> <methods:Method*> "}"
        => {
            let (generics,bounds)=generic_info.unwrap_or_default();
            Item::Impl(Impl {generics,trait_name:None,target,associated_types,
                methods:methods.into_iter().map(|mut m| {
                    let mut constraints=bounds.clone();constraints.extend(where_bounds.clone());
                    constraints.extend(m.concept_bounds);m.concept_bounds=constraints;m
                }).collect()})
        },
    "impl" <generic_info:GenericHeader?> <trait_name:Path> "for" <target:Type> <where_bounds:WhereConcepts> "{" <associated_types:AssociatedTypeBinding*> <methods:Method*> "}"
        => {
            let (generics,bounds)=generic_info.unwrap_or_default();
            Item::Impl(Impl {generics,trait_name:Some(trait_name),target,associated_types,
                methods:methods.into_iter().map(|mut m| {
                    let mut constraints=bounds.clone();constraints.extend(where_bounds.clone());
                    constraints.extend(m.concept_bounds);m.concept_bounds=constraints;m
                }).collect()})
        },
    "import" <path:Path> ";" => Item::Import(path),
    "mod" <at:@L> <name:MemberIdent> ";" => Item::Mod {name,at},
    // C++-style type alias using the existing `use` keyword. Plain imports
    // keep their existing meaning: `use module::Name;`.
    "use" <name:Ident> "=" <target:Type> ";"
        => Item::TypeAlias(TypeAlias {name, target}),
    "use" <at:@L> <path:UsePath> ";" => Item::Use {path,at},
};

// Traits carry their operator binding in source rather than in the Rust
// compiler. #[operator(bit_or)] is metadata on the Nova trait declaration.
TraitDef: Trait = {
    "trait" <name:Ident> <restriction:TraitRestrictionRule?> <parents:TraitParents> "{" <associated_types:AssociatedTypeDecl*> <methods:TraitMethodRule*> "}"
        => Trait {attributes:vec![],name,restriction,parents,associated_types,methods},
    "trait" <restriction:TraitRestrictionRule> <name:Ident> <parents:TraitParents> "{" <associated_types:AssociatedTypeDecl*> <methods:TraitMethodRule*> "}"
        => Trait {attributes:vec![],name,restriction:Some(restriction),parents,associated_types,methods},
};

// Typed fragments are parsed as actual AST nodes, not strings of source code.
// Legacy `macro double(value)` continues to mean `value:expr`.
// Arms are parsed directly as AST fragments, never token-string substitutions.
// The terminator is explicit (as accepted by Rust macro_rules! definitions).
MacroArmRule: MacroArm = {
    "(" <params:Comma<MacroParamDef>> ")" "=>" <body:Expr> ";"
        => MacroArm {params,body:MacroBody::Expression(body)},
    "(" <params:Comma<MacroParamDef>> ")" "=>" <body:Block> ";"
        => MacroArm {params,body:MacroBody::Statements(body)},
};
MacroParamDef: MacroParam = {
    "$" "(" <param:MacroSingleParam> ")" "," "*"
        => MacroParam {repetition:Some(MacroRepetition::ZeroOrMore),..param},
    "$" "(" <param:MacroSingleParam> ")" "," "+"
        => MacroParam {repetition:Some(MacroRepetition::OneOrMore),..param},
    "$" "(" <param:MacroSingleParam> ")" "?"
        => MacroParam {repetition:Some(MacroRepetition::Optional),..param},
    MacroSingleParam,
};
// `where Concept` constrains the inferred type of the corresponding AST
// expression; `where same_as<i64>` supplies extra concept type arguments.
// Concept checks are emitted as ordinary generic function specializations,
// so existing Nova concept/trait/requires validation applies to macro values.
MacroConceptRule: MacroConcept = {
    "where" <name:Path> "<" <additional_args:NonEmptyComma<Type>> ">"
        => MacroConcept {name, additional_args},
    "where" <name:Path>
        => MacroConcept {name, additional_args:vec![]},
};
MacroSingleParam: MacroParam = {
    <name:Ident> ":" "expr" <concept:MacroConceptRule?>
        => MacroParam {name,fragment:MacroFragment::Expr,concept,repetition:None},
    <name:Ident> ":" "ident" <concept:MacroConceptRule?>
        => MacroParam {name,fragment:MacroFragment::Ident,concept,repetition:None},
    <name:Ident> ":" "literal" <concept:MacroConceptRule?>
        => MacroParam {name,fragment:MacroFragment::Literal,concept,repetition:None},
    <name:Ident> ":" "path" <concept:MacroConceptRule?>
        => MacroParam {name,fragment:MacroFragment::Path,concept,repetition:None},
    <name:Ident> => MacroParam {name,fragment:MacroFragment::Expr,concept:None,repetition:None},
};
TraitRestrictionRule: TraitRestriction = {
    "<" <type_parameter:Ident> "in" <permitted_types:NonEmptyComma<Type>> ">"
        => TraitRestriction { type_parameter, permitted_types },
};
TraitParents: Vec<String> = {
    "extends" <parents:Comma<Path>> => parents,
    => vec![],
};
AssociatedTypeDecl: String = {"type" <name:Ident> ";" => name};
AssociatedTypeBinding: (String,TypeRef) = {"type" <name:Ident> "=" <ty:Type> ";" => (name,ty)};
TraitMethodRule: TraitMethod = {
    "fn" <name:FunctionName> "(" <params:Comma<Param>> ")" "->" <result:Type> ";"
        => TraitMethod {name, params, result, default_body: None},
    "fn" <name:FunctionName> "(" <params:Comma<Param>> ")" "->" <result:Type> <body:Block>
        => TraitMethod {name, params, result, default_body: Some(body)},
};
AttributeName: String = {
    // `comptime` starts a function declaration but is also a valid marker
    // attribute: `#[comptime]`. Keep it contextual (not a general Ident)
    // to avoid changing expression/statement parse precedence.
    "comptime" => "comptime".into(),
    "operator" => "operator".into(),
    "requires" => "requires".into(),
    "unsafe" => "unsafe".into(),
    "const" => "const".into(),
    // `async` is a keyword in function declarations, but remains valid as
    // an explicitly checked effect attribute on a declaration.
    "async" => "async".into(),
    Ident,
};
// An attribute argument is metadata, not an expression. Some method and
// protocol names (notably `next`) are reserved as expression prefixes, so
// they cannot be parsed through Path/Ident. Accept them contextually here,
// without broadening Ident and reintroducing LALRPOP ambiguities.
MetaAttributeArgument: String = {
    "async" => "async".into(),
    "struct" => "struct".into(),
    "enum" => "enum".into(),
    "trait" => "trait".into(),
    "fn" => "function".into(),
    MetaReservedArgument,
    Path,
};
// Keep this list consistent with reserved member names in MemberIdent when
// they are also valid metadata values, e.g. #[meta_protocol(advance, next)].
MetaReservedArgument: String = {
    "next" => "next".into(),
    "finished" => "finished".into(),
    "resume" => "resume".into(),
    "join" => "join".into(),
    "spawn" => "spawn".into(),
    "dispose" => "dispose".into(),
    "sync" => "sync".into(),
    "scope" => "scope".into(),
};
AnnotationValue: String = {
    <text:r#""([^"\\]|\\.)*""#> => text.to_string(),
    <negative:"-"?> <digits:r"[0-9]+"> => format!("{}{}", if negative.is_some(){"-"}else{""}, digits),
    "true" => "true".into(),
    "false" => "false".into(),
};
AnnotationArgument: String = {
    // `scope` starts a lexical statement in Nova and is not a general
    // identifier. Annotation keys are a distinct syntactic context:
    // @Service(scope = "singleton") must not turn `scope` into an Expr name.
    "scope" "=" <value:AnnotationValue> => format!("scope={value}"),
    <name:Ident> "=" <value:AnnotationValue> => format!("{name}={value}"),
    AnnotationValue,
    MetaAttributeArgument,
};
// A qualified annotation has one leading name and a non-empty, right-
// recursive suffix. It is not a generic Path: the leading keyword set is
// different, and a nested Path here can compete with the following field Type.
AnnotationName: String = {
    <name:AttributeName> => name,
    <name:AttributeName> "::" <tail:AnnotationNameTail> => format!("{name}::{tail}"),
};
AnnotationNameTail: String = {
    <name:MemberIdent> => name,
    <name:MemberIdent> "::" <tail:AnnotationNameTail> => format!("{name}::{tail}"),
};
Attribute: Attribute = {
    // Declarative `@Service`, `@Int(min = 10, max = 20)` annotations.
    // One production for marker and parameterized annotations: this avoids
    // multiplying item/method/field parser states for identical @ prefixes.
    "@" <name:AnnotationName> <args:("(" <Comma<AnnotationArgument>> ")")?>
        => Attribute {name,args:args.unwrap_or_default()},
    // Struct derives and legacy attributes.
    "#" "[" <name:AttributeName> "(" <args:Comma<MetaAttributeArgument>> ")" "]" => Attribute { name, args },
    // Marker attributes on functions (also accepted in Rust-style notation).
    "#" "[" <name:AttributeName> "]" => Attribute { name, args: vec![] },
    "[" "[" <name:AttributeName> "]" "]" => Attribute { name, args: vec![] },
};
// Concepts form a separate compile-time predicate grammar: they never become
// runtime expressions. This keeps constraints out of the LLVM ABI.
ConceptOr: ConceptExpr = {
    <left:ConceptOr> "||" <right:ConceptAnd> => ConceptExpr::Or(Box::new(left),Box::new(right)),
    ConceptAnd,
};
ConceptAnd: ConceptExpr = {
    <left:ConceptAnd> "&&" <right:ConceptUnary> => ConceptExpr::And(Box::new(left),Box::new(right)),
    ConceptUnary,
};
ConceptUnary: ConceptExpr = {
    "!" <inner:ConceptUnary> => ConceptExpr::Not(Box::new(inner)),
    "requires" "(" <variables:Comma<RequireParam>> ")" "{" <rules:RequireRule*> "}"
        => ConceptExpr::Requires {variables,rules},
    "(" <inner:ConceptOr> ")" => inner,
    "true" => ConceptExpr::Literal(true),
    "false" => ConceptExpr::Literal(false),
    <name:Path> "<" <args:NonEmptyComma<ConceptArgument>> ">" => ConceptExpr::Apply{name,args},
};
// Compile-time intrinsic arguments can denote contextual member names.
// `next` is reserved as the generator operator in expressions, but must
// remain available for `has_method<T, next>` without introducing a runtime
// identifier or permitting the keyword as a general type name.
ConceptArgument: TypeRef = {
    "next" => TypeRef::Named("next".into()),
    "new" => TypeRef::Named("new".into()),
    "get" => TypeRef::Named("get".into()),
    Type,
};
RequireParam: (String,TypeRef) = {
    <ty:Type> <variable:Ident> => (variable,ty),
};
RequireRule: Requirement = {
    "type" <owner:Ident> "::" <item:Ident> ";" => Requirement::AssociatedType {owner,item},
    "{" <variable:Ident> "." <field:MemberIdent> "}" "->" <result:Type> ";"
        => Requirement::Field {variable,field,result},
    "{" <variable:Ident> "." <method:MemberIdent> "(" <arguments:Comma<Type>> ")" "}" "->" <result:Type> ";"
        => Requirement::Method {variable,method,arguments,result},
    "{" <owner:Ident> "::" <method:MemberIdent> "(" <arguments:Comma<Type>> ")" "}" "->" <result:Type> ";"
        => Requirement::StaticMethod {owner,method,arguments,result},
    "{" <left:Ident> "+" <right:Ident> "}" "->" <result:Type> ";"
        => Requirement::Binary {left,operation:BinaryOp::Add,right,result},
    "{" <left:Ident> "-" <right:Ident> "}" "->" <result:Type> ";"
        => Requirement::Binary {left,operation:BinaryOp::Sub,right,result},
    "{" <left:Ident> "*" <right:Ident> "}" "->" <result:Type> ";"
        => Requirement::Binary {left,operation:BinaryOp::Mul,right,result},
    "{" <left:Ident> "/" <right:Ident> "}" "->" <result:Type> ";"
        => Requirement::Binary {left,operation:BinaryOp::Div,right,result},
    "{" <left:Ident> "|" <right:Ident> "}" "->" <result:Type> ";"
        => Requirement::Binary {left,operation:BinaryOp::BitOr,right,result},
    "{" <left:Ident> "&" <right:Ident> "}" "->" <result:Type> ";"
        => Requirement::Binary {left,operation:BinaryOp::BitAnd,right,result},
    "{" <left:Ident> "^" <right:Ident> "}" "->" <result:Type> ";"
        => Requirement::Binary {left,operation:BinaryOp::BitXor,right,result},
};
ConceptUse: ConceptBound = {
    <name:Path> "<" <args:NonEmptyComma<Type>> ">" => ConceptBound{name,args},
};
WhereConcepts: Vec<ConceptBound> = {
    "where" <bounds:Comma<ConceptUse>> => bounds,
    => vec![],
};
GenericBoundParam: (String,Option<String>) = {
    <parameter:Ident> ":" <constraint:Path> => (parameter,Some(constraint)),
    <parameter:Ident> => (parameter,None),
};
// Keep the generic clause non-nullable. The old FunctionGenerics had an
// empty alternative, which collided with its own '<' prefix after class,
// enum and function names (LALRPOP 0.22.2 shift/reduce conflict).
GenericHeader: (Vec<String>,Vec<ConceptBound>) = {
    "<" <parameters:NonEmptyComma<GenericBoundParam>> ">" => {
        let mut names=Vec::new();let mut bounds=Vec::new();
        for (name,constraint) in parameters {
            if let Some(concept)=constraint {
                bounds.push(ConceptBound{name:concept,args:vec![TypeRef::Named(name.clone())]});
            }
            names.push(name);
        }
        (names,bounds)
    },
};
// Integrate the optional suffix with its name, instead of a nullable grammar
// rule shared by declarations and impl. The '<' token now selects one
// syntactically distinct branch; a bare name cannot eat that lookahead.
TypeDeclName: (String,Vec<String>,Vec<ConceptBound>) = {
    <name:Ident> <info:GenericHeader> => (name,info.0,info.1),
    <name:Ident> => (name,vec![],vec![]),
};
FunctionDeclName: (String,Vec<String>,Vec<ConceptBound>) = {
    <name:FunctionName> <info:GenericHeader> => (name,info.0,info.1),
    <name:FunctionName> => (name,vec![],vec![]),
};
FunctionName: String = {
    <name:MemberIdent> => name,
    "apply" => "apply".into(),
    "also" => "also".into(),
    "let" => "let".into(),
    "run" => "run".into(),
    "with" => "with".into(),
};
Generics: Vec<String> = {
    "<" <generics:NonEmptyComma<Ident>> ">" => generics,
    => vec![],
};
// `with Trait1, Trait2` is Nova syntax for #[capabilities(...)]. Both
// forms enter the same compile-time validation path; no LLVM flags exist.
CapabilityClause: Vec<String> = {
    "with" <traits:Comma<Path>> => traits,
};
StructDef: Struct = {
    "struct" <header:TypeDeclName> <flags:CapabilityClause?> <parent:Parent?> "{" <fields:Comma<Field>> "}"
        => Struct { name:header.0, generics:header.1, concept_bounds:header.2, fields,
            attributes:flags.map(|args|vec![Attribute{name:"capabilities".into(),args}]).unwrap_or_default(),
            is_class: false, parent },
    "class" <header:TypeDeclName> <flags:CapabilityClause?> <parent:Parent?> "{" <fields:Comma<Field>> "}"
        => Struct { name:header.0, generics:header.1, concept_bounds:header.2, fields,
            attributes:flags.map(|args|vec![Attribute{name:"capabilities".into(),args}]).unwrap_or_default(),
            is_class: true, parent },
};
Parent: TypeRef = { ":" <base:Type> => base };

// Syntactic sugar for a method in an explicit `impl Trait for Type`.
// The trait's #[operator(...)] metadata decides the actual method name;
// the symbol itself does not hard-code a method in the compiler.
OperatorToken: String = {
    "+" => "add".into(),
    "-" => "sub".into(),
    "*" => "mul".into(),
    "/" => "div".into(),
    "%" => "rem".into(),
    "==" => "eq".into(),
    "!=" => "ne".into(),
    "<" => "lt".into(),
    "<=" => "le".into(),
    ">" => "gt".into(),
    ">=" => "ge".into(),
    "&" => "bit_and".into(),
    "|" => "bit_or".into(),
    "^" => "bit_xor".into(),
    "<<" => "shift_left".into(),
    ">>" => "shift_right".into(),
};
OperatorMethod: Function = {
    "operator" <key:OperatorToken> "(" <params:Comma<FnParam>> ")" "->" <result:Type> <body:Block>
        => {
            let variadic=params.last().map(|(_,v)|*v).unwrap_or(false);
            let params=params.into_iter().map(|(mut p,v)| {
                if v && !variadic {p.name=format!("__nova_invalid_pack__{}",p.name);}
                p
            }).collect();
            Function {mode:FunctionMode::Normal,name:format!("__nova_op__{key}"),
                generics:vec![],concept_bounds:vec![],params,variadic,result,body,
                is_virtual:false,is_override:false,attributes:vec![]}
        },
};

// Modifiers apply only to methods. `override` requires a virtual ancestor.
Method: Function = {
    // Read-only computed property. It is an ordinary Nova method, so the
    // compiler does not create a hidden field, vtable or runtime descriptor.
    "property" <name:MemberIdent> ":" <result:Type> "{" "get" "=>" <value:Expr> ";" "}"
        => Function { mode:FunctionMode::Normal, name:format!("property_{name}"),
            generics:vec![], concept_bounds:vec![],
            params:vec![Param {name:"self".into(),ty:TypeRef::Reference {
                mutable:false,inner:Box::new(TypeRef::Named("Self".into()))},
                default:None,attributes:vec![]}], variadic:false, result,
            body:vec![Stmt::Return(Some(value))], is_virtual:false,
            is_override:false, attributes:vec![] },
    // Spring-style annotations may precede a static handler method.
    // `@GetMapping("/users") static fn index(...)` and the legacy
    // `static @GetMapping("/users") fn index(...)` are both accepted.
    // One static-method production handles both annotation orders, including
    // @GetMapping(...) static fn and static @GetMapping(...) fn. The optional
    // prefix avoids duplicating the whole static-method parse subtree.
    <annotations:Attribute*> "static" <f:Function> => Function { attributes: {
        let mut attrs=f.attributes.clone();
        attrs.extend(annotations);
        attrs.push(Attribute {name:"static".into(),args:vec![]});
        attrs
    }, ..f },
    OperatorMethod,
    "virtual" <f:Function> => Function { is_virtual: true, ..f },
    "override" <f:Function> => Function { is_override: true, ..f },
    Function,
};
EnumDef: Enum = {
    "enum" <header:TypeDeclName> "{" <variants:Comma<Variant>> "}"
        => Enum { name:header.0, generics:header.1, concept_bounds:header.2, variants, attributes: vec![] },
};
Variant: Variant = {
    <name:Ident> "(" <payload:Comma<Type>> ")" => Variant { name, payload },
    <name:Ident> => Variant {name,payload:vec![]},
};
// The next '(' after @Name belongs to annotation arguments. Previously it
// could instead begin the unit type '()' of the field, making @Name() locally
// ambiguous. Separate undecorated fields (which still accept the unit type)
// from decorated fields. Decorated unit fields may use an alias such as Unit.
Field: Field = {
    <name:MemberIdent> ":" <ty:Type> "=" <default:Expr>
        => Field {name,ty,default:Some(default),attributes:vec![]},
    <name:MemberIdent> ":" <ty:Type>
        => Field {name,ty,default:None,attributes:vec![]},
    <name:MemberIdent> ":" <attributes:Attribute+> <ty:AnnotatedFieldType> "=" <default:Expr>
        => Field {name,ty,default:Some(default),attributes},
    <name:MemberIdent> ":" <attributes:Attribute+> <ty:AnnotatedFieldType>
        => Field {name,ty,default:None,attributes},
};
// Only the immediate '()' case is excluded. Reference types, arrays and
// function types may still contain the unit type in their nested positions.
AnnotatedFieldType: TypeRef = {
    "dyn" <name:Path> => TypeRef::Named(format!("dyn {name}")),
    "[" <inner:Type> ";" <n:r"[0-9]+"> "]" => TypeRef::Array(Box::new(inner), n.parse().unwrap_or(0)),
    "*" "const" <inner:Type> => TypeRef::Pointer {mutable:false,inner:Box::new(inner)},
    "*" "mut" <inner:Type> => TypeRef::Pointer {mutable:true,inner:Box::new(inner)},
    "&" <mutability:"mut"?> <inner:Type> => TypeRef::Reference {mutable:mutability.is_some(),inner:Box::new(inner)},
    <name:Path> "<" <args:NonEmptyComma<Type>> ">" => TypeRef::Applied(name,args),
    "fn" "(" <params:Comma<Type>> ")" "->" <result:Type> => TypeRef::Function {params,result:Box::new(result)},
    "auto" => TypeRef::Named("auto".into()),
    <name:Path> => TypeRef::Named(name),
};
Function: Function = {
    "const" <f:FunctionBase> => { let mut attributes=vec![Attribute{name:"const".into(),args:vec![]}]; attributes.extend(f.attributes.clone()); Function { attributes, ..f } },
    "comptime" <f:FunctionBase> => { let mut attributes=vec![Attribute{name:"comptime".into(),args:vec![]}]; attributes.extend(f.attributes.clone()); Function { attributes, ..f } },
    <attributes:Attribute+> <f:FunctionBase> => { let mut merged=f.attributes.clone(); merged.extend(attributes); Function { attributes:merged, ..f } },
    FunctionBase,
};
EffectRequirements: Vec<String> = {
    "requires" "(" <effects:Comma<EffectName>> ")" => effects,
};
EffectName: String = {
    <name:Path> => name,
};
FunctionBase: Function = {
    "fn" <header:FunctionDeclName> "(" <params:Comma<FnParam>> ")" "->" <result:Type> <effect_requirements:EffectRequirements?> <where_bounds:WhereConcepts> <body:Block>
         => {
            let variadic=params.last().map(|(_,v)|*v).unwrap_or(false);
            let params=params.into_iter().map(|(mut p,v)| {
                if v && !variadic {p.name=format!("__nova_invalid_pack__{}",p.name);}
                p
            }).collect();
            let (name,generics,mut concept_bounds)=header;
            concept_bounds.extend(where_bounds);
            let attributes=effect_requirements.map(|args|vec![Attribute{name:"effects".into(),args}]).unwrap_or_default();
            Function {mode:FunctionMode::Normal,name,generics,concept_bounds,params,variadic,result,body,is_virtual:false,is_override:false,attributes}
        },
    "gen" "fn" <header:FunctionDeclName> "(" <params:Comma<FnParam>> ")" "->" <result:Type> <effect_requirements:EffectRequirements?> <where_bounds:WhereConcepts> <body:Block>
         => {
            let variadic=params.last().map(|(_,v)|*v).unwrap_or(false);
            let params=params.into_iter().map(|(mut p,v)| {
                if v && !variadic {p.name=format!("__nova_invalid_pack__{}",p.name);}
                p
            }).collect();
            let (name,generics,mut concept_bounds)=header;
            concept_bounds.extend(where_bounds);
            let attributes=effect_requirements.map(|args|vec![Attribute{name:"effects".into(),args}]).unwrap_or_default();
            Function {mode:FunctionMode::Generator,name,generics,concept_bounds,params,variadic,result,body,is_virtual:false,is_override:false,attributes}
        },
    "coro" "fn" <header:FunctionDeclName> "(" <params:Comma<FnParam>> ")" "->" <result:Type> <effect_requirements:EffectRequirements?> <where_bounds:WhereConcepts> <body:Block>
         => {
            let variadic=params.last().map(|(_,v)|*v).unwrap_or(false);
            let params=params.into_iter().map(|(mut p,v)| {
                if v && !variadic {p.name=format!("__nova_invalid_pack__{}",p.name);}
                p
            }).collect();
            let (name,generics,mut concept_bounds)=header;
            concept_bounds.extend(where_bounds);
            let attributes=effect_requirements.map(|args|vec![Attribute{name:"effects".into(),args}]).unwrap_or_default();
            Function {mode:FunctionMode::Coroutine,name,generics,concept_bounds,params,variadic,result,body,is_virtual:false,is_override:false,attributes}
        },
    "async" "fn" <header:FunctionDeclName> "(" <params:Comma<FnParam>> ")" "->" <result:Type> <effect_requirements:EffectRequirements?> <where_bounds:WhereConcepts> <body:Block>
         => {
            let variadic=params.last().map(|(_,v)|*v).unwrap_or(false);
            let params=params.into_iter().map(|(mut p,v)| {
                if v && !variadic {p.name=format!("__nova_invalid_pack__{}",p.name);}
                p
            }).collect();
            let (name,generics,mut concept_bounds)=header;
            concept_bounds.extend(where_bounds);
            let attributes=effect_requirements.map(|args|vec![Attribute{name:"effects".into(),args}]).unwrap_or_default();
            Function {mode:FunctionMode::Async,name,generics,concept_bounds,params,variadic,result,body,is_virtual:false,is_override:false,attributes}
        },
};
// C ABI ellipsis `...` is distinct from Nova `...values: T`.
// Parsing both through the same comma list avoids shift/reduce conflicts.
ExternFunction: ExternFunction = {
    <attributes:Attribute+> <f:ExternFunctionBase> => ExternFunction { attributes, ..f },
    ExternFunctionBase,
};
ExternFunctionBase: ExternFunction = {
    "extern" "fn" <name:FunctionName> "(" <arguments:Comma<ExternParam>> ")" "->" <result:Type> ";"
        => {
            let c_variadic=arguments.last().map(|a|a.is_none()).unwrap_or(false);
            let mut params=Vec::new();
            for (i,arg) in arguments.into_iter().enumerate(){
                if let Some(param)=arg {params.push(param);}
                else if !c_variadic || i!=params.len(){
                    params.push(Param{name:"__nova_invalid_c_varargs__".into(),ty:TypeRef::Named("i32".into()),default:None,attributes:vec![]});
                }
            }
            ExternFunction { name, params, result, c_variadic, attributes:vec![] }
        },
};
ExternParam: Option<Param> = {
    "..." => None,
    <param:Param> => Some(param),
};

// `out` is compiler-only sugar for an exclusive output borrow. Keep its
// marker until call-site validation and definite-assignment checking.
Param: Param = {
    "out" <name:Ident> ":" <ty:Type> => Param {
        name, ty:TypeRef::Applied("__nova_internal_out_type".into(),vec![ty]),default:None,attributes:vec![]
    },
    <attributes:Attribute+> <name:Ident> ":" <ty:Type> <default:("=" <Expr>)?> => Param { name, ty, default, attributes },
    <name:Ident> ":" <ty:Type> <default:("=" <Expr>)?> => Param { name, ty, default, attributes:vec![] }
};
FnParam: (Param,bool) = {
    "..." <param:Param> => (param,true),
    <param:Param> => (param,false),
};
// Closures do not support default parameters. Using Param here admitted
// `= Expr` before the closing `|`: the parser could consume that delimiter
// as a bitwise-or operator inside the default value instead of ending the
// parameter list. This propagated incorrect lookaheads across the entire
// expression-precedence hierarchy (LALRPOP shift/reduce conflicts).
LambdaParam: Param = {
    "out" <name:Ident> ":" <ty:Type> => Param {
        name, ty:TypeRef::Applied("__nova_internal_out_type".into(),vec![ty]), default:None, attributes:vec![]
    },
    <name:Ident> ":" <ty:Type> => Param { name,ty,default:None,attributes:vec![] },
};
Type: TypeRef = {
    "dyn" <name:Path> => TypeRef::Named(format!("dyn {name}")),
    "impl" <name:Path> => TypeRef::Named(format!("impl {name}")),
    "[" <inner:Type> ";" <n:r"[0-9]+"> "]" => TypeRef::Array(Box::new(inner), n.parse().unwrap_or(0)),
    "*" "const" <inner:Type> => TypeRef::Pointer { mutable: false, inner: Box::new(inner) },
    "*" "mut" <inner:Type> => TypeRef::Pointer { mutable: true, inner: Box::new(inner) },
    "&" <mutability:"mut"?> <inner:Type> => TypeRef::Reference { mutable:mutability.is_some(), inner:Box::new(inner) },
    <name:Path> "<" <args:NonEmptyComma<Type>> ">" => TypeRef::Applied(name,args),
    "fn" "(" <params:Comma<Type>> ")" "->" <result:Type> => TypeRef::Function {params, result:Box::new(result)},
    "auto" => TypeRef::Named("auto".into()),
    <name:Path> => TypeRef::Named(name),
    "(" ")" => TypeRef::Named("()".into()),
};
// Imports accept a final `*` as a path segment. Keeping it in the
// same path nonterminal avoids a shift/reduce ambiguity with `Path::Member`.
UsePath: String = {
    <first:Ident> <rest:("::" <UseSegment>)*> => {
        let mut path=first;
        for segment in rest {path.push_str("::");path.push_str(&segment);}
        path
    },
};
UseSegment: String = {
    <name:MemberIdent> => name,
    "*" => "*".into(),
};
// Right-recursive qualified paths avoid the nullable `("::" MemberIdent)*`
// expansion, which introduced another shift/reduce conflict on `::`.
// A `::<` generic-call suffix remains separate from ordinary path segments.
Path: String = {
    <name:Ident> => name,
    <name:Ident> "::" <tail:PathSegments> => format!("{name}::{tail}"),
};
PathSegments: String = {
    <name:MemberIdent> => name,
    <name:MemberIdent> "::" <tail:PathSegments> => format!("{name}::{tail}"),
};
// A block's final expression is the only expression without a semicolon.
// Bare `if` statements remain statements, but an exhaustive final if/else
// chain is converted into a value after parsing, avoiding an LALR(1)
// competition between Stmt::If and Expr::If.
Block: Vec<Stmt> = {
    "{" <mut body:Stmt*> <tail:Expr?> "}" => {
        if let Some(value) = tail { body.push(Stmt::Tail(value)); }
        crate::ast::normalize_block_tail(body)
    }
};
// Syntactic sugar: else if becomes a nested If inside the else block.
// This preserves the existing AST/HIR/MIR representation and avoids an extra variant.
ElseBlock: Vec<Stmt> = {
    "else" <body:Block> => body,
    "else" "if" <condition:Expr> <then_body:Block> <else_body:ElseBlock?>
        => vec![Stmt::If { condition, then_body, else_body }],
};
Stmt: Stmt = {
    // Repeated statement fragments are represented as internal AST nodes
    // and eliminated by the macro expander before semantic analysis.
    "$" "(" <body:Stmt*> ")" "*" => Stmt::If {
        condition:Expr::Var("__nova_macro_stmt_repeat_star".into()),
        then_body:body, else_body:None
    },
    "$" "(" <body:Stmt*> ")" "+" => Stmt::If {
        condition:Expr::Var("__nova_macro_stmt_repeat_plus".into()),
        then_body:body, else_body:None
    },
    "$" "(" <body:Stmt*> ")" "?" => Stmt::If {
        condition:Expr::Var("__nova_macro_stmt_repeat_optional".into()),
        then_body:body, else_body:None
    },
    // Refutable let-else binds a variant's payload for the rest of the block.
    // No runtime primitive is required: normalize_block_tail rewrites the
    // continuation into an ordinary enum match before type checking.
    "let" <path:Path> "(" <bindings:Comma<Ident>> ")" "=" <value:ValueExpr> "else" <failure:Block> ";"
        => crate::ast::refutable_let_else(path, bindings, value, failure),
    // Struct/array bindings are expanded to single-evaluation field/index reads.
    "let" <name:Path> "{" <names:Comma<Ident>> "}" "=" <init:ValueExpr> ";"
        => crate::ast::destructure_binding(Some(name),names,init),
    "let" "(" <names:Comma<Ident>> ")" "=" <init:ValueExpr> ";"
        => crate::ast::destructure_binding(None,names,init),
    // Explicit ownership replacement. The marker is lowered after the
    // concrete local type and its Drop implementation are known.
    "replace" <name:Ident> "=" <value:Expr> ";"
        => crate::ast::replace_stmt(name, value),
    // Declarative cascade. The receiver may be parenthesized or a target-typed
    // `new(...)`; the declared local type is forwarded to the generated
    // cascade temporary so bare `new()` can resolve its constructor.
    "let" <mutability:"mut"?> <name:Ident> <ty:(":" <Type>)?> "="
        <base:CascadeReceiver> ".." <assignments:CascadeAssignments> ";"
        => Stmt::Let {
            name,
            mutable: mutability.is_some(),
            ty: ty.clone().filter(|t| *t != TypeRef::Named("auto".into())),
            init: crate::ast::cascade_expr(base, assignments, ty),
            defer: None,
        },
    "let" <mutability:"mut"?> <name:Ident> <ty:(":" <Type>)?> "=" <init:ValueExpr> <defer:("defer" <Expr>)?> ";"
        => Stmt::Let { name, mutable: mutability.is_some(), ty: ty.filter(|t| *t != TypeRef::Named("auto".into())), init, defer },
    // `using` is a declaration form; use the existing `scope { ... }` to
    // delimit its cleanup lifetime without adding a nested block production.
    "using" <name:Ident> <ty:(":" <Type>)?> "=" <init:ValueExpr>
        "defer" <cleanup:Expr> ";"
        => Stmt::Let {
            name,
            mutable: false,
            ty: ty.filter(|t| *t != TypeRef::Named("auto".into())),
            init,
            defer: Some(cleanup),
        },
    // RAII form: the owner is cleaned up by the normal HIR destructor pass.
    // An explicit `defer` remains available when cleanup needs arguments or a
    // custom operation instead of the type's Drop implementation.
    "using" <name:Ident> <ty:(":" <Type>)?> "=" <init:ValueExpr> ";"
        => Stmt::Let {
            name,
            mutable: false,
            ty: ty.filter(|t| *t != TypeRef::Named("auto".into())),
            init,
            defer: None,
        },
    "auto" <mutability:"mut"?> <name:Ident> "=" <init:ValueExpr> <defer:("defer" <Expr>)?> ";"
        => Stmt::Let { name, mutable: mutability.is_some(), ty: None, init, defer },
    "defer" <cleanup:Expr> ";" => Stmt::Defer(cleanup),
    "*" <name:Ident> "=" <value:Expr> ";" => Stmt::DerefSet{name,value},
    // All assignments share the *same* PostfixExpr prefix used by normal
    // expression statements. A separate `Ident "." Ident` statement prefix
    // competes with the `Path` -> `PostfixExpr` field-access production on
    // the dot token and causes an LR(1) shift/reduce conflict in LALRPOP.
    // The helper validates that only direct local or local.field assignments
    // are currently supported by the semantic lowering pipeline.
    <target:PostfixExpr> <op:AssignmentOp> <value:Expr> ";"
        => crate::ast::assignment_stmt(target, op, value),
    "return" <value:ValueExpr> ";" => Stmt::Return(Some(value)),
    "return" ";" => Stmt::Return(None),
    // Refutable binding without boilerplate `match`. Bindings exist only in
    // the successful arm; the subject is evaluated exactly once.
    "if" "let" <pattern:Pattern> "=" <value:Expr> <then_body:Block> <else_body:ElseBlock?>
        => Stmt::Match { value, arms: vec![
            MatchArm {pattern, body:then_body},
            MatchArm {pattern:Pattern::Wildcard,body:else_body.unwrap_or_default()}
        ] },
    "if" <condition:Expr> <then_body:Block> <else_body:ElseBlock?>
        => Stmt::If { condition, then_body, else_body },
    // Refutable loop re-evaluates its expression each iteration and breaks
    // on the first non-match, without allocating an iterator adapter.
    "while" "let" <pattern:Pattern> "=" <value:Expr> <body:Block>
        => Stmt::Loop(vec![Stmt::Match { value, arms:vec![
            MatchArm {pattern,body},
            MatchArm {pattern:Pattern::Wildcard,body:vec![Stmt::Break]}
        ]}]),
    "while" <condition:Expr> <body:Block> => Stmt::While { condition, body },
    "loop" <body:Block> => Stmt::Loop(body),
    "for" <name:Ident> "in" <start:Expr> ".." <end:Expr> <body:Block>
        => Stmt::For { name, start, end, body },
    "for" <name:Ident> "in" <iterable:Expr> <body:Block>
        => Stmt::ForEach { name, iterable, body },
    "break" ";" => Stmt::Break,
    "continue" ";" => Stmt::Continue,
    // A synchronization region is carried to the concurrency pass using an
    // internal marker, then lowered to a lexical RAII guard before HIR.
    "sync" "(" <locks:Comma<Ident>> ")" <guard:("as" <Ident>)?> <body:Block>
        => Stmt::If {
            condition: Expr::Call(
                format!("__nova_internal_sync_region::{}", guard.unwrap_or_default()),
                locks.into_iter().map(Expr::Var).collect()
            ), then_body: body, else_body: None
        },
    // A plain lexical scope is useful for deterministic thread/guard teardown.
    "scope" <body:Block> => Stmt::If {
        condition: Expr::Bool(true), then_body: body, else_body: None
    },
    "unsafe" <body:Block> => Stmt::Unsafe(body),
    "match" <value:Expr> "{" <arms:MatchArms> "}"
        => Stmt::Match { value, arms },
    <expression:Expr> ";" => Stmt::Expr(expression),
};
// Use one assignment operator nonterminal so `=`, `+=`, `-=` and the
// other compound forms all follow a single unambiguous expression prefix.
AssignmentOp: Option<BinaryOp> = {
    "=" => None,
    "+=" => Some(BinaryOp::Add),
    "-=" => Some(BinaryOp::Sub),
    "*=" => Some(BinaryOp::Mul),
    "/=" => Some(BinaryOp::Div),
    "%=" => Some(BinaryOp::Rem),
    "&=" => Some(BinaryOp::BitAnd),
    "|=" => Some(BinaryOp::BitOr),
    "^=" => Some(BinaryOp::BitXor),
    "<<=" => Some(BinaryOp::Shl),
    ">>=" => Some(BinaryOp::Shr),
};
MatchArm: MatchArm = {
    <pattern:Pattern> "=>" <body:Block> => MatchArm {pattern,body},
};
// Nova permits adjacent match arms without commas (as used in std::crypto),
// comma-separated arms and an optional trailing comma.
// Keep the comma outside MatchArm: an optional comma *inside* MatchArm
// conflicts with reducing the arm in LALRPOP when the next token is a comma.
// In this right-recursive list, the next token after a complete arm chooses
// the comma branch, the adjacent-pattern branch, or the empty tail.
MatchArms: Vec<MatchArm> = {
    => vec![],
    <head:MatchArm> "," <tail:MatchArms> => {
        let mut output = vec![head];
        output.extend(tail);
        output
    },
    <head:MatchArm> <tail:MatchArms> => {
        let mut output = vec![head];
        output.extend(tail);
        output
    },
};
Pattern: Pattern = {
    <path:Path> "(" <bindings:Comma<Ident>> ")" => Pattern::Variant {path,bindings},
    <path:Path> => if path=="_" {Pattern::Wildcard}else{Pattern::Variant {path,bindings:vec![]}},
};
// A compact expression-bodied closure binds more weakly than every binary
// operator. To apply an operator to a closure value, parenthesize the closure.
pub Expr: Expr = {
    PipelineExpr,
    "|" <params:Comma<LambdaParam>> "|" <value:Expr> => Expr::Lambda {
        params,
        result:TypeRef::Named("auto".into()),
        body:vec![Stmt::Return(Some(value))]
    },
};
// The pipeline injects the preceding value as the first call argument.
// `x |> f |> g(y)` is equivalent to `g(f(x), y)`; every step evaluates once.
PipelineExpr: Expr = {
    <value:PipelineExpr> "|>" <stage:Atom> => crate::ast::pipeline_call(value,stage),
    CoalesceExpr
};
// Lazy optional fallback; lowered to a typed enum match before HIR.
CoalesceExpr: Expr = {
    <value:OrExpr> "??" <fallback:CoalesceExpr> => Expr::Call(
        "__nova_internal_coalesce".into(), vec![value,fallback]),
    OrExpr
};
OrExpr: Expr = {<l:OrExpr> "||" <r:AndExpr> => Expr::Binary(Box::new(l),BinaryOp::Or,Box::new(r)), AndExpr};
AndExpr: Expr = {<l:AndExpr> "&&" <r:BitOrExpr> => Expr::Binary(Box::new(l),BinaryOp::And,Box::new(r)), BitOrExpr};
BitOrExpr: Expr = {<l:BitOrExpr> "|" <r:BitXorExpr> => Expr::Binary(Box::new(l),BinaryOp::BitOr,Box::new(r)), BitXorExpr};
BitXorExpr: Expr = {<l:BitXorExpr> "^" <r:BitAndExpr> => Expr::Binary(Box::new(l),BinaryOp::BitXor,Box::new(r)), BitAndExpr};
BitAndExpr: Expr = {<l:BitAndExpr> "&" <r:EqualityExpr> => Expr::Binary(Box::new(l),BinaryOp::BitAnd,Box::new(r)), EqualityExpr};
EqualityExpr: Expr = {
    <l:EqualityExpr> "==" <r:CompareExpr> => Expr::Binary(Box::new(l),BinaryOp::Eq,Box::new(r)),
    <l:EqualityExpr> "!=" <r:CompareExpr> => Expr::Binary(Box::new(l),BinaryOp::Ne,Box::new(r)),CompareExpr,
};
CompareExpr: Expr = {
    <l:CompareExpr> "<" <r:ShiftExpr> => Expr::Binary(Box::new(l),BinaryOp::Lt,Box::new(r)),
    <l:CompareExpr> "<=" <r:ShiftExpr> => Expr::Binary(Box::new(l),BinaryOp::Le,Box::new(r)),
    <l:CompareExpr> ">" <r:ShiftExpr> => Expr::Binary(Box::new(l),BinaryOp::Gt,Box::new(r)),
    <l:CompareExpr> ">=" <r:ShiftExpr> => Expr::Binary(Box::new(l),BinaryOp::Ge,Box::new(r)),ShiftExpr,
};
ShiftExpr: Expr = {
    <l:ShiftExpr> "<<" <r:AddExpr> => Expr::Binary(Box::new(l),BinaryOp::Shl,Box::new(r)),
    <l:ShiftExpr> ">>" <r:AddExpr> => Expr::Binary(Box::new(l),BinaryOp::Shr,Box::new(r)),AddExpr,
};
AddExpr: Expr = {
    <l:AddExpr> "+" <r:MulExpr> => Expr::Binary(Box::new(l),BinaryOp::Add,Box::new(r)),
    <l:AddExpr> "-" <r:MulExpr> => Expr::Binary(Box::new(l),BinaryOp::Sub,Box::new(r)),MulExpr,
};
MulExpr: Expr = {
    <l:MulExpr> "*" <r:CastExpr> => Expr::Binary(Box::new(l),BinaryOp::Mul,Box::new(r)),
    <l:MulExpr> "/" <r:CastExpr> => Expr::Binary(Box::new(l),BinaryOp::Div,Box::new(r)),
    <l:MulExpr> "%" <r:CastExpr> => Expr::Binary(Box::new(l),BinaryOp::Rem,Box::new(r)),CastExpr,
};
// `&mut value as (*mut T)` must mean `(&mut value) as (*mut T)`.
// Casts bind less tightly than unary address/deref operations.
CastExpr: Expr = {
    <e:CastExpr> "as" <ty:CastType> => Expr::Cast(Box::new(e),ty),
    UnaryExpr,
};
UnaryExpr: Expr = {
    "-" <e:UnaryExpr> => Expr::Unary(UnaryOp::Neg,Box::new(e)),
    "!" <e:UnaryExpr> => Expr::Unary(UnaryOp::Not,Box::new(e)),
    "~" <e:UnaryExpr> => Expr::Unary(UnaryOp::BitNot,Box::new(e)),
    "&" <mutability:"mut"?> <e:UnaryExpr> => Expr::AddressOf {mutable:mutability.is_some(),value:Box::new(e)},
    "*" <e:UnaryExpr> => Expr::Deref(Box::new(e)),
    "yield" <e:UnaryExpr> => Expr::Yield(Box::new(e)),
    "await" <e:UnaryExpr> => Expr::Await(Box::new(e)),
    // Coroutine operations are language syntax. The compiler lowers them to
    // generic, ABI-compatible STD primitives, without user-facing imports.
    "next" <handle:UnaryExpr> => Expr::MethodCall(Box::new(handle),"next".into(),vec![],vec![]),
    "finished" <handle:UnaryExpr> => Expr::MethodCall(Box::new(handle),"finished".into(),vec![],vec![]),
    "resume" <handle:UnaryExpr> => Expr::MethodCall(Box::new(handle),"resume".into(),vec![Expr::Int("0".into())],vec![]),
    "join" <handle:UnaryExpr> => Expr::MethodCall(Box::new(handle),"wait".into(),vec![],vec![]),
    "spawn" <handle:UnaryExpr> => Expr::MethodCall(Box::new(handle),"schedule".into(),vec![],vec![]),
    "dispose" <handle:UnaryExpr> => Expr::MethodCall(Box::new(handle),"drop".into(),vec![],vec![]),
    "..." <e:UnaryExpr> => Expr::Spread(Box::new(e)),
    PostfixExpr,
};
// A cast must not reuse the unrestricted `Type` rule directly. That rule
// accepts `Path <Type>` and competes with comparison `<` while parsing an
// expression (including macro/call argument lists and struct initializers).
// Bare casts accept named types; compound types use `as (Type)` so the
// enclosing parentheses make the generic/pointer grammar unambiguous.
CastType: TypeRef = {
    <name:Path> => TypeRef::Named(name),
    "(" <ty:Type> ")" => ty,
};
PostfixExpr: Expr = {
    // Optional chaining and propagation are lowered into ordinary match arms.
    <e:PostfixExpr> "?" => Expr::Call("__nova_internal_try".into(),vec![e]),
    <e:PostfixExpr> "?." <name:MemberIdent> "(" <args:Comma<CallArgument>> ")" => {
        let mut values=vec![e, Expr::Str(name)]; values.extend(args);
        Expr::Call("__nova_internal_optional_method".into(), values)
    },
    <e:PostfixExpr> "?." <name:MemberIdent> => Expr::Call(
        "__nova_internal_optional_field".into(), vec![e, Expr::Str(name)]),
    <e:PostfixExpr> "." <name:MemberIdent> "::<" <types:NonEmptyComma<Type>> ">" "(" <args:Comma<CallArgument>> ")"
        => Expr::MethodCall(Box::new(e),name,args,types),
    <e:PostfixExpr> "." <name:MemberIdent> "(" <args:Comma<CallArgument>> ")"
        => Expr::MethodCall(Box::new(e),name,args,vec![]),
    // `apply` is a dedicated postfix form; it is not a general member with
    // an optional block, so normal field access remains unambiguous.
    <e:PostfixExpr> "." "apply" <body:Block>
        => crate::ast::apply_expr(e, body),
    <e:PostfixExpr> "." "also" <body:Block>
        => crate::ast::scope_expr(e, "also", body),
    <e:PostfixExpr> "." "let" <body:Block>
        => crate::ast::scope_expr(e, "let", body),
    <e:PostfixExpr> "." "run" <body:Block>
        => crate::ast::scope_expr(e, "run", body),
    <e:PostfixExpr> "." "with" <body:Block>
        => crate::ast::scope_expr(e, "with", body),
    <e:PostfixExpr> "." <field:MemberIdent> => Expr::Field(Box::new(e),field),
    <e:PostfixExpr> "[" <index:Expr> "]" => Expr::Index(Box::new(e),Box::new(index)),
    Atom,
};
// A value-producing if must have an else. Keep its starting keyword outside
// Atom: otherwise "if" can begin both Stmt::If and an Expr at the tail of a
// block, which produces a shift/reduce conflict in LALRPOP.
IfValueElse: Vec<Stmt> = {
    <body:Block> => body,
    <nested:IfValue> => vec![Stmt::Tail(nested)],
};
IfValue: Expr = {
    "if" <condition:Expr> <then_body:Block> "else" <else_body:IfValueElse>
        => Expr::If { condition:Box::new(condition), then_body, else_body },
};
// Braced lexical blocks and if/else values can appear in value positions.
// Ordinary expressions still use the existing precedence grammar.
ValueExpr: Expr = {
    IfValue,
    // Keep unsafe expressions at the value level, like if/match expressions.
    // Putting this production in Atom conflicts with the statement form
    // `unsafe { ... }` when the parser is deciding between a statement and a
    // tail expression.
    "unsafe" <body:Block>
        => Expr::Call("__nova_internal_unsafe_expr".into(), vec![Expr::Block(body)]),
    MatchValue,
    <body:Block> => Expr::Block(body),
    Expr,
};
CascadeReceiver: Expr = {
    "new" "(" <args:Comma<CallArgument>> ")"
        => Expr::Call("__nova_target_new".into(), args),
    "(" <base:Expr> ")" => base,
};

// Match as a value reuses exhaustive enum matching; its arms become
// continuations before type checking. No runtime enum visitor is introduced.
MatchValue: Expr = {
    "match" <value:Expr> "{" <arms:MatchArms> "}"
        => Expr::Block(vec![
            Stmt::Expr(Expr::Var("__nova_internal_match_value".into())),
            Stmt::Match {value,arms}
        ]),
};
CascadeAssignments: Vec<(String, Option<BinaryOp>, Expr)> = {
    <field:MemberIdent> <op:AssignmentOp> <value:OrExpr> <rest:CascadeAssignmentRest> => {
        let mut assignments = vec![(field, op, value)];
        assignments.extend(rest);
        assignments
    }
};
CascadeAssignmentRest: Vec<(String, Option<BinaryOp>, Expr)> = {
    => vec![],
    ".." <field:MemberIdent> <op:AssignmentOp> <value:OrExpr> <rest:CascadeAssignmentRest> => {
        let mut assignments = vec![(field, op, value)];
        assignments.extend(rest);
        assignments
    }
};
Atom: Expr = {
    // Kotlin-style top-level receiver scope. The postfix spelling
    // `value.with { ... }` is also accepted below in PostfixExpr.
    "with" "(" <base:Expr> ")" <body:Block>
        => crate::ast::scope_expr(base, "with", body),
    "resume" "(" <handle:Expr> "," <resume_value:Expr> ")"
        => Expr::MethodCall(Box::new(handle), "resume".into(), vec![resume_value], vec![]),
    "fn" "(" <params:Comma<Param>> ")" "->" <result:Type> <body:Block> => Expr::Lambda {params,result,body},
    "|" <params:Comma<LambdaParam>> "|" "->" <result:Type> <body:Block> => Expr::Lambda {params,result,body},
    // Scientific notation is one floating-point token, not a decimal followed
    // by an identifier like `e308`. Recognize signed exponents and
    // mantissas with or without a decimal point (1e3, 1.5E-2).
    <n:r"[0-9]+(\.[0-9]+)?[eE][+-]?[0-9]+"> => Expr::Float(n.to_string()),
    <n:r"[0-9]+\.[0-9]+"> => Expr::Float(n.to_string()),
    <n:r"[0-9]+"> => Expr::Int(n.to_string()),
    "true" => Expr::Bool(true),
    "false" => Expr::Bool(false),
    "(" ")" => Expr::Unit,
    <s:r#""([^"\\]|\\.)*""#> => Expr::Str(s.to_string()),
    // A Unicode character literal is distinct from a string. The surface
    // pass decodes and validates escapes before lowering to a typed char.
    <s:r#"'([^'\\]|\\.)*'"#> => Expr::Cast(
        Box::new(Expr::Str(s.to_string())), TypeRef::Named("char".into())),
    // C++-style construction is sugar for a static `new` defined in Nova.
    // Field initialization remains `new Type { field: value }`.
    // Target-typed construction uses the expected type from the surrounding
    // expression, e.g. `let value: Counter = new(7);`.
    "new" "(" <args:Comma<CallArgument>> ")"
        => Expr::Call("__nova_target_new".into(),args),
    "new" <name:Path> "<" <generics:NonEmptyComma<Type>> ">" "(" <args:Comma<CallArgument>> ")"
        => Expr::GenericCall(format!("{name}::new"),generics,args),
    "new" <name:Path> "(" <args:Comma<CallArgument>> ")"
        => Expr::Call(format!("{name}::new"),args),
    "new" <name:Path> "<" <generics:NonEmptyComma<Type>> ">" "{" <fields:Comma<FieldInit>> "}"
        => Expr::GenericStructInit(name,generics,fields),
    "new" <name:Path> "{" <fields:Comma<FieldInit>> "}"
        => Expr::StructInit(name,fields),
    // List comprehension. It is lowered to std::algorithm::comprehend, so it
    // works with the same Vec/foreach protocol as explicit collection code.
    // Keep the comprehension head at the precedence level below `for`; using
    // the top-level Expr here makes LALRPOP prefer the ordinary array branch
    // when it sees the contextual `for` token.
    "[" <value:OrExpr> "for" "(" <name:Ident> ":" <item_ty:Type> ")" "in" <collection:OrExpr> "if" <predicate:OrExpr> "]"
        => crate::ast::list_comprehension(name,item_ty,collection,value,Some(predicate)),
    "[" <value:OrExpr> "for" "(" <name:Ident> ":" <item_ty:Type> ")" "in" <collection:OrExpr> "]"
        => crate::ast::list_comprehension(name,item_ty,collection,value,None),
    // The untyped spelling is accepted for parser tooling; semantic typing
    // will request `for item: T in ...` when the collection element type is
    // not available to infer a callback parameter.
    "[" <value:OrExpr> "for" <name:Ident> "in" <collection:OrExpr> "if" <predicate:OrExpr> "]"
        => crate::ast::list_comprehension(name,TypeRef::Named("auto".into()),collection,value,Some(predicate)),
    "[" <value:OrExpr> "for" <name:Ident> "in" <collection:OrExpr> "]"
        => crate::ast::list_comprehension(name,TypeRef::Named("auto".into()),collection,value,None),
    "[" <members:Comma<Expr>> "]" => Expr::Array(members),
    // AST splice. Only valid inside argument lists/arrays of a macro template.
    "$" "(" <value:Expr> ")" "," "*"
        => Expr::Call("__nova_macro_repeat_star".into(),vec![value]),
    "$" "(" <value:Expr> ")" "," "+"
        => Expr::Call("__nova_macro_repeat_plus".into(),vec![value]),
    "$" "(" <value:Expr> ")" "?"
        => Expr::Call("__nova_macro_repeat_optional".into(),vec![value]),
    // `get` is a contextual property keyword, but also a legal global function.
    // Keep calls distinct from the special `property ... { get => ... }` production.
    "get" "(" <args:Comma<CallArgument>> ")" => Expr::Call("get".into(),args),
    <name:Path> "!" "(" <args:Comma<Expr>> ")" => Expr::MacroCall(name,args),
    <name:Path> "!" "[" <args:Comma<Expr>> "]" => Expr::MacroCall(name,args),
    <name:Path> "!" "{" <args:Comma<Expr>> "}" => Expr::MacroCall(name,args),
    <name:Path> "::<" <generics:NonEmptyComma<Type>> ">" "(" <args:Comma<CallArgument>> ")"
        => Expr::GenericCall(name,generics,args),
    <name:Path> "(" <args:Comma<CallArgument>> ")"
        => Expr::Call(name,args),
    <name:Path> => Expr::Var(name),
    "(" <e:Expr> ")" => e,
};
// Named arguments are AST expressions only until signature binding. They are
// never lowered directly into the typed HIR.
CallArgument: Expr = {
    // C#-style output declaration using Nova's existing `let` keyword.
    "out" "let" <name:Ident> <ty:(":" <Type>)?> => Expr::Call(
        "__nova_internal_out_declare".into(),
        vec![Expr::Var(name), ty.map(Expr::Zero).unwrap_or(Expr::Unit)]),
    "out" <value:OutPlace> => Expr::Call("__nova_internal_out_argument".into(),vec![value]),
    <name:Ident> ":" <value:Expr> => Expr::Call("__nova_internal_named_arg".into(),vec![Expr::Str(name),value]),
    Expr,
};
// Restrict output targets to lvalues. Besides rejecting nonsensical forms
// like `out compute()`, this keeps the existing `out(...)` function-call
// syntax unambiguous for users who already have a function named `out`.
OutPlace: Expr = {
    <name:Ident> <fields:("." <MemberIdent>)*> => {
        fields.into_iter().fold(Expr::Var(name),|base,field|Expr::Field(Box::new(base),field))
    },
    <name:Ident> "[" <index:Expr> "]" => Expr::Index(Box::new(Expr::Var(name)),Box::new(index)),
};
FieldInit: (String,Expr) = {
    <name:MemberIdent> ":" <expr:Expr> => (name,expr),
    // `new Point { x, y }` uses the locals with the same names.
    <name:MemberIdent> => (name.clone(), Expr::Var(name)),
};
// Only non-prefix-operator keywords can be identifiers in contextual positions:
// `coro` can name a module (std::coro), and `use` is the Express middleware
// method name (app.use(callback) and fn use(...)).  LALRPOP's literal
// keywords win over the identifier regex; enumerate these cases explicitly.
// Prefix operators (next, finished, resume, join, spawn, dispose) must not
// also be Ident: that creates LR(1) shift/reduce conflicts with UnaryExpr.
// The top-level `use foo::bar;` import rule remains unchanged.
// Contextual members/declarations/struct fields do not compete with
// expression-prefix operators. `next cursor` remains unary syntax while
// `cursor.next()` and `entry.next` remain legal method/field names.
MemberIdent: String = {
    Ident,
    // `get` is a keyword in property accessors (`property x { get => ... }`)
    // but remains a valid method name: obj.get(), fn get(...), std::vec::get.
    // Keep it contextual here instead of making it a general expression Ident.
    "get" => "get".into(),
    // `sync` and `scope` are reserved statement starters, but remain valid
    // members of qualified paths (e.g. std::sync::new_i64) and method names.
    // Keeping them out of Ident avoids a grammar ambiguity between
    // sync(a) as guard { ... } and a call followed by an `as` cast.
    "sync" => "sync".into(),
    "scope" => "scope".into(),
    "new" => "new".into(),
    "next" => "next".into(),
    "finished" => "finished".into(),
    "resume" => "resume".into(),
    "join" => "join".into(),
    "spawn" => "spawn".into(),
    "dispose" => "dispose".into(),
    "coro" => "coro".into(),
    // `replace` is also a statement keyword, but remains valid as a method
    // name (for example `Guard<T>::replace(value)`).
    "replace" => "replace".into(),
};
Ident: String = {
    <s:r"[a-zA-Z_][a-zA-Z0-9_]*"> => s.to_string(),
    // `out` remains a contextual keyword: existing STD and self-host code
    // legitimately use it as a parameter/local name (`fn append(out: u64)`).
    "out" => "out".to_string(),
    // Unlike `coro` and `use`, sync/scope cannot start ordinary identifiers:
    // they introduce concurrency statements with an overlapping Expr prefix.
    "use" => "use".to_string(),
    "type" => "type".to_string(),
    "$" <name:r"[a-zA-Z_][a-zA-Z0-9_]*"> => format!("${name}"),
    "expr" => "expr".to_string(),
    "ident" => "ident".to_string(),
    "literal" => "literal".to_string(),
    "path" => "path".to_string(),
};
// A comma-separated list with one unambiguous interpretation.
// Trailing commas are intentionally not supported in v0.4, avoiding
// LALRPOP shift/reduce conflicts when T can itself start with an identifier.
Comma<T>: Vec<T> = {
    => vec![],
    <head:T> <tail:("," <T>)*> => {
        let mut values = vec![head];
        values.extend(tail);
        values
    },
};

// Angle-bracketed generics and macro concept type arguments are never empty.
// Keep the nullable Comma<T> only for actual optional lists (e.g. fn()).
// Right recursion also avoids the `Comma<GenericBoundParam>` tail reduction
// conflicting with the next comma in LALRPOP's merged states.
NonEmptyComma<T>: Vec<T> = {
    <head:T> => vec![head],
    <head:T> "," <tail:NonEmptyComma<T>> => {
        let mut values=vec![head];
        values.extend(tail);
        values
    },
};
